#!/usr/bin/env ruby
# encoding: utf-8
# frozen_string_literal: true
#
# Build generated/usf_associations.json from corpora/usf/Cue_Target_Pairs.* shards.
#
# USF Free Association Norms (Nelson, McEvoy & Schreiber 1998): for each
# stimulus CUE, the words a participant produced as a free association,
# with forward strength FSG = #participants giving the target / #G. Used at
# runtime by lib/rhymecrime/relatedness/signals.rb for direct (1-hop) and
# Numberbatch-validated 2-hop association evidence.
#
# Output schema (consumed by signals.rb's usf_associations loader):
#   { "<cue>": { "<target>": <fsg float>, ... }, ... }
# Lemmas are lowercase single-token (matching dict.rb's headword shape);
# multi-word targets like "PINK PANTHER" are dropped since they can't be
# looked up against the dict vocabulary.
#
#   ./bin/build-usf-associations
#   ./bin/build-usf-associations /path/to/out.json

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "rhymecrime/build/utils_rhyme"

build_usf_associations!(ARGV[0])
