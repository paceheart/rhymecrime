#!/usr/bin/env bash
#
# Fetch (and pre-aggregate) every external corpus that bin/build consumes.
# Idempotent — downloads are skipped if the destination file is already present
# and non-empty, and generated corpus mirrors are rebuilt only when missing,
# stale, or in an older on-disk format.
#
# Normally invoked via ./setup.sh, which runs bundle install first and
# bin/build after. You can also run ./bin/setup-corpora directly if
# gems are already installed and you only want to refresh the inputs (e.g. to
# pick up a new Wiktionary dump without re-resolving the Gemfile).
#
# Prereqs on the host: ruby + bundler (for bin/build-usf-associations and
# bin/preprocess-conceptnet), python3, curl, gunzip.

set -euo pipefail

REPO="$(cd "$(dirname "$0")/.." && pwd -P)"
cd "$REPO"

# --- Wiktionary (kaikki.org / wiktextract) → corpora/wiktionary/ ------------
# Pronunciation + POS + forms + alt/form-of senses. The streaming filter logic
# lives in bin/filter-kaikki so it's easy to re-run when we want to pick up
# additional fields from the raw dump.
mkdir -p corpora/wiktionary
if [ ! -s corpora/wiktionary/kaikki-english-filtered.jsonl.gz ]; then
  curl -fL "https://kaikki.org/dictionary/English/kaikki.org-dictionary-English.jsonl" \
    | bin/filter-kaikki \
    | gzip > corpora/wiktionary/kaikki-english-filtered.jsonl.gz
fi

# NOTE: VarCon (corpora/varcon/) and SUBTLEX-US (corpora/subtlex/) are vendored
# directly in the repo (force-added past corpora/* in .gitignore) — see
# THIRD_PARTY_NOTICES.md for attribution. They aren't fetched here.

# --- Wordfreq Zipf export → generated/wordfreq.tsv --------------------------
# (gitignored; used by dict.rb / dict-build)
# Use python3 -m pip so wordfreq installs for the same interpreter as
# python3 (asdf/pyenv).
python3 -m pip install --user -r lib/rhymecrime/build/wordfreq/requirements.txt
mkdir -p generated
python3 lib/rhymecrime/build/wordfreq/export_wordfreq_tsv.py

# --- USF Free Association Norms → generated/usf_associations.json ----------
# Runtime graph compiled from the raw Cue_Target_Pairs.* shards that are
# checked in under corpora/usf/. Consumed by lib/rhymecrime/relatedness/signals.rb
# for direct (1-hop) and Numberbatch-validated 2-hop association evidence.
# Cheap (<1s) so we run it unconditionally; the shards are the source of truth.
mkdir -p generated
./bin/build-usf-associations

# --- ConceptNet 5.7 assertions (CC-BY-SA 4.0) → corpora/conceptnet/ ---------
# https://github.com/commonsense/conceptnet5/wiki/Downloads
# Lemma list gzip for fast headword intersection lives under generated/;
# dict-build also auto-builds it if missing/stale.
mkdir -p corpora/conceptnet
if [ ! -s corpora/conceptnet/conceptnet-assertions-5.7.0.csv.gz ]; then
  curl -fL -o corpora/conceptnet/conceptnet-assertions-5.7.0.csv.gz \
    "https://s3.amazonaws.com/conceptnet/downloads/2019/edges/conceptnet-assertions-5.7.0.csv.gz"
fi
./bin/preprocess-conceptnet

# --- ConceptNet corpus mirror → generated/conceptnet_edges.msgpack -----------
# Stable full-corpus streamed MessagePack. Runtime/build readers filter it
# against word_dict at load time, so dict-build never needs to regenerate it.
bundle exec ruby -I lib -e 'require "rhymecrime/build/build_utils"; ensure_conceptnet_edges_cache!'

# --- ConceptNet Numberbatch 19.08 English (CC-BY-SA 4.0) --------------------
# → corpora/numberbatch/numberbatch-en-19.08.txt
# Official distribution is .txt.gz; gunzip leaves the plain .txt that
# corpus_caches / paths expect.
# https://github.com/commonsense/conceptnet-numberbatch#downloads
mkdir -p corpora/numberbatch
if [ ! -s corpora/numberbatch/numberbatch-en-19.08.txt ]; then
  curl -fL -o corpora/numberbatch/numberbatch-en-19.08.txt.gz \
    "https://conceptnet.s3.amazonaws.com/downloads/2019/numberbatch/numberbatch-en-19.08.txt.gz"
  gunzip -f corpora/numberbatch/numberbatch-en-19.08.txt.gz
fi

# --- Numberbatch corpus mirror → generated/numberbatch_vectors.msgpack -------
# Stable full-corpus streamed MessagePack. Readers filter it against word_dict at
# load time, so dict-build / bin/build treat it as a setup-produced input.
bundle exec ruby -I lib -e 'require "rhymecrime/build/build_utils"; ensure_numberbatch_vectors_cache!'
