#!/usr/bin/env ruby
# frozen_string_literal: true

# derivational-lemma-impact-probe — empirical test of two lemma-merge
# questions, side by side:
#
#   (A) Would ADDING new derivational merges preserve relatedness signal?
#       (cohort: +derivational+, lemma-distinct pairs only)
#   (B) Are the EXISTING +compute_lemma_map+ merges preserving signal, or is
#       the inflected form's neighborhood materially different from the base's?
#       (cohort: +lemma_collapsed+, raw-mode scoring — scores the surface
#       forms directly to simulate "what if we didn't collapse this pair?")
#
# The test: for each candidate pair +(base, derived)+, sample K random anchor
# headwords +X+ from the cue set and score +rel(a, X)+ and +rel(b, X)+ via the
# relatedness-score threshold, collapsing each to a Boolean classification
# (+related+ vs +not+). Two Boolean-only summaries per pair:
#
#   * agreement - fraction of anchors where the two Booleans match (including
#                 both-false; inflated by the long tail of unrelated anchors).
#   * jaccard   - |positives shared| / |positives union|, the sharper signal
#                 since it restricts to the positive class.
#
# Anchor side is always lemmatized (matches runtime). Pair side is lemmatized
# for the derivational/negation/random cohorts (runtime mirror) but left RAW
# for the +lemma_collapsed+ cohort, so we can measure the counterfactual
# neighborhood of the inflected form.
#
# Four cohorts:
#
#   derivational     - WN-derivationally-linked pairs with a suffix-only
#                      surface difference (the "would a new merge rule be
#                      safe?" question). Sourced via
#                      +wn_derivation_target_lemmas_for_word+.
#   lemma_collapsed  - pairs +(inflected, lemma(inflected))+ the existing
#                      +compute_lemma_map+ ALREADY collapses. Scored in raw
#                      mode to expose any neighborhood drift lost by the
#                      current merge (the "is the existing merge discarding
#                      signal?" question).
#   negation         - +un+ prefix pairs (control — we expect distinct related-
#                      word neighborhoods because +happy+-neighbors and
#                      +unhappy+-neighbors should diverge).
#   random           - random dictionary-word pairs (floor baseline).
#
# Output:
#   spec/derivational_lemma_impact_probe.csv - one row per (pair, anchor);
#                                              columns include cohort, base,
#                                              derived, transform,
#                                              lemma_merged, raw_pair_mode,
#                                              anchor, base_related,
#                                              derived_related.
#   stdout                                    - per-cohort agreement + jaccard
#                                              quartiles; per-transform
#                                              stratified sub-tables for both
#                                              +derivational+ and
#                                              +lemma_collapsed+ cohorts.
#
# Usage:
#   ruby bin/derivational-lemma-impact-probe [--deriv-cap=N] [--lemma-cap=N]
#                                            [--cap=M] [--anchors=K]
#                                            [--seed=N] [--output=PATH]
#
# Defaults: deriv-cap=500, lemma-cap=500, cap=50 (negation + random),
#           anchors=100, seed=1,
#           output=spec/derivational_lemma_impact_probe.csv.

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

ENV.delete("RHYMECRIME_DATA_SOURCE")

require "csv"
require "fileutils"
require "optparse"
require_relative "../lib/rhymecrime/dict/utils_rhyme"
require_relative "../lib/rhymecrime/frontend"
require_relative "../lib/rhymecrime/dict/rime"
# +wn_derivation_target_lemmas_for_word+ (the derivational-cohort enumerator)
# lives in +dict/lexical+; +frontend+ doesn't transitively pull it in.
require_relative "../lib/rhymecrime/dict/lexical"
require_relative "../lib/rhymecrime/relatedness/signals"
require_relative "../lib/rhymecrime/relatedness/score"

deriv_cap = 500
lemma_cap = 500
cap = 50
anchors = 100
seed = 1
output_path = File.expand_path("../spec/derivational_lemma_impact_probe.csv", __dir__)

OptionParser.new do |o|
  o.on("--deriv-cap=N", Integer, "Pairs for derivational cohort (default: #{deriv_cap})") { |n| deriv_cap = [n, 1].max }
  o.on("--lemma-cap=N", Integer, "Pairs for lemma-collapsed cohort (default: #{lemma_cap})") { |n| lemma_cap = [n, 1].max }
  o.on("--cap=M", Integer, "Pairs per baseline cohort (default: #{cap})") { |n| cap = [n, 1].max }
  o.on("--anchors=K", Integer, "Anchors per pair (default: #{anchors})") { |n| anchors = [n, 1].max }
  o.on("--seed=N", Integer, "Random seed (default: #{seed})") { |n| seed = n }
  o.on("--output=PATH", "CSV output path") { |p| output_path = File.expand_path(p) }
end.parse!

word_path = generated_dict_path(WORD_DICT_FILENAME)
unless File.exist?(word_path)
  warn "Missing #{word_path} — run bin/dict-build first."
  exit 1
end

wd = word_dict
headwords_arr = wd.keys.select { |w| cue_word?(w, wd) }.sort
headwords = headwords_arr.to_set
puts "Loaded #{headwords.size} cue-eligible headwords"

# Stable anchor pool: deterministic shuffle of the full cue set, seeded.
# Same anchors used across every pair so per-cohort statistics are directly
# comparable (Jaccard / Pearson move the same way when measured against the
# same vector). Drawn once outside the cohort loops.
anchor_rng = Random.new(seed)
anchor_pool = headwords_arr.shuffle(random: anchor_rng).first(anchors)
puts "Sampled #{anchor_pool.size} anchor headwords (seed=#{seed})"

# Score cache keyed by sorted (a, b) so we don't recompute when the same anchor
# lines up with both a base and a derived form via different pairs. ~200 anchors
# × ~100 unique words ≈ 20k keys max, fits comfortably in RAM.
$score_cache = {}
def cached_score(a, b)
  x, y = a <= b ? [a, b] : [b, a]
  key = [x, y]
  $score_cache[key] ||= relatedness_score(PairSignals.new(x, y))
end

# Reject pairs where one surface is +prefix+ +the+ other — rationale in the
# prefix-relatedness-probe writeup: every +COMMON_PREFIXES+ string fails the
# same-synset test, so a prefix-differing pair is never a safe lemma merge.
def prefix_derivation?(a, b)
  long, short = a.length >= b.length ? [a, b] : [b, a]
  COMMON_PREFIXES.any? { |p| long == p + short }
end

# --- Cohort enumeration -------------------------------------------------------

def enumerate_derivational_pairs(headwords_arr, headwords_set, cap, seed)
  # Walk cue-eligible headwords in shuffled order and collect WN-derivation
  # edges to other cue-eligible headwords until we have +cap+ pairs. Stop
  # early — full enumeration is ~60k pointer walks (a minute or two of WN I/O);
  # we only need a sample.
  rng = Random.new(seed + 1001)
  order = headwords_arr.shuffle(random: rng)
  seen = Set.new # normalized unordered pair keys so we don't double-count
  pairs = []
  order.each do |w|
    break if pairs.size >= cap
    targets = wn_derivation_target_lemmas_for_word(w)
    next if targets.nil? || targets.empty?
    targets.each do |t|
      break if pairs.size >= cap
      next if t == w
      next unless headwords_set.include?(t)
      next if prefix_derivation?(w, t)
      key = [w, t].sort
      next if seen.include?(key)
      seen << key
      pairs << key
    end
  end
  pairs
end

def enumerate_un_prefix_pairs(headwords_arr, headwords_set, cap, seed)
  rng = Random.new(seed + 2002)
  shuffled = headwords_arr.shuffle(random: rng)
  pairs = []
  shuffled.each do |w|
    break if pairs.size >= cap
    next unless w.start_with?("un")
    base = w[2..]
    next if base.nil? || base.length < 3
    next unless headwords_set.include?(base)
    pairs << [base, w]
  end
  pairs
end

def enumerate_random_pairs(headwords_arr, cap, seed)
  rng = Random.new(seed + 3003)
  pairs = []
  attempts = 0
  seen = Set.new
  while pairs.size < cap && attempts < cap * 100
    attempts += 1
    a = headwords_arr.sample(random: rng)
    b = headwords_arr.sample(random: rng)
    next if a == b
    key = [a, b].sort
    next if seen.include?(key)
    seen << key
    pairs << key
  end
  pairs
end

# +(inflected, base)+ pairs the existing +compute_lemma_map+ currently collapses:
# +lemma(inflected) == base != inflected+, both present as +word_dict+ headwords
# (the lemma side is required to be an actual dict entry so +PairSignals+ has a
# real surface for it). We deliberately don't require +cue_word?+ here — the
# inflected side usually isn't cue-eligible (it's not the preferred form), but
# we still need to ask "what would its neighborhood look like if we didn't
# collapse it?".
def enumerate_lemma_collapsed_pairs(wd, cap, seed)
  rng = Random.new(seed + 4004)
  order = wd.keys.shuffle(random: rng)
  pairs = []
  order.each do |w|
    break if pairs.size >= cap
    lw = lemma(w)
    next if lw.nil? || lw == w
    next unless wd.key?(lw)
    pairs << [lw, w] # sorted not by alpha; keep [base, inflected] canonical
  end
  pairs
end

puts "Enumerating derivational cohort..."
deriv_pairs = enumerate_derivational_pairs(headwords_arr, headwords, deriv_cap, seed)
puts "  #{deriv_pairs.size} pairs"
puts "Enumerating lemma-collapsed cohort..."
lemma_pairs = enumerate_lemma_collapsed_pairs(wd, lemma_cap, seed)
puts "  #{lemma_pairs.size} pairs"
puts "Enumerating negation (un-) cohort..."
un_pairs = enumerate_un_prefix_pairs(headwords_arr, headwords, cap, seed)
puts "  #{un_pairs.size} pairs"
puts "Enumerating random-baseline cohort..."
rand_pairs = enumerate_random_pairs(headwords_arr, cap, seed)
puts "  #{rand_pairs.size} pairs"

# Canonicalize a pair's surface transform. Shorter word becomes +base+; longest
# common prefix is stripped; we emit one of three shapes:
#
#   +suffix              - derived = base + suffix (e.g. +herald+/+heraldic+ -> +ic+)
#   -btail/+dtail        - pair diverges after a shared stem (e.g.
#                          +incompetent+/+incompetence+ -> +-t/+ce+,
#                          +happy+/+happiness+ -> +-y/+iness+)
#   =                    - identical or degenerate (filtered upstream; kept as
#                          a sentinel for debuggability)
#
# Keys are coarse surface patterns, not linguistic suffixes — they group
# +herald+/+heraldry+ and +green+/+greenery+ under +-/+ry+ and +-/+ery+
# separately even though both are nominalization suffixes. That's intentional:
# the user's "safe to merge" question is about empirical relatedness-
# neighborhood preservation, not linguistic taxonomy, so raw surface grouping
# is the right stratification.
def derivational_transform_key(a, b)
  # shorter first; if tied, alphabetical for determinism
  short, long = a.length < b.length ? [a, b] : b.length < a.length ? [b, a] : [a, b].sort
  i = 0
  min_len = [short.length, long.length].min
  i += 1 while i < min_len && short[i] == long[i]
  short_tail = short[i..]
  long_tail = long[i..]
  return "=" if short_tail.empty? && long_tail.empty?
  return "+#{long_tail}" if short_tail.empty?
  "-#{short_tail}/+#{long_tail}"
end

# Per-cohort scoring config. +raw_pair_mode+ controls whether the pair's sides
# go through +lemma()+ before scoring:
#
#   false (default)  - mirror the runtime predicate: score
#                      +rel(lemma(a), lemma(anchor))+. Used for cohorts where
#                      we're asking "do these two lemmas share a neighborhood?"
#                      (derivational, negation, random).
#
#   true             - bypass +lemma()+ on the pair sides only, score
#                      +rel(a_surface, lemma(anchor))+. Used for the
#                      +lemma_collapsed+ cohort so we can ask the
#                      counterfactual: "if the lemma map DIDN'T collapse this
#                      inflected form, would its neighborhood differ from the
#                      base's?"
#
# The anchor is always lemmatized (matches runtime), otherwise we'd be
# comparing two different normalization regimes at once.
cohorts = {
  "derivational"    => { pairs: deriv_pairs,  raw_pair_mode: false },
  "lemma_collapsed" => { pairs: lemma_pairs,  raw_pair_mode: true  },
  "negation"        => { pairs: un_pairs,     raw_pair_mode: false },
  "random"          => { pairs: rand_pairs,   raw_pair_mode: false },
}

# --- Scoring -------------------------------------------------------------------

def percentile(vals, p)
  return nil if vals.empty?
  sorted = vals.sort
  idx = ((p / 100.0) * (sorted.size - 1)).round.clamp(0, sorted.size - 1)
  sorted[idx]
end

rows = []
cohort_pair_stats = Hash.new { |h, k| h[k] = [] }
thr = RELATEDNESS_SCORE_THRESHOLD

cohorts.each do |cohort, cfg|
  pairs = cfg[:pairs]
  raw_pair_mode = cfg[:raw_pair_mode]
  puts "\nScoring cohort '#{cohort}' (#{pairs.size} pairs × #{anchor_pool.size} anchors, raw_pair_mode=#{raw_pair_mode})..."
  t0 = Time.now
  pairs.each_with_index do |(base, derived), idx|
    # Pair sides used for +PairSignals+. In default mode we lemmatize both
    # sides (runtime mirror); in raw mode we pass the surface forms
    # through so the +lemma_collapsed+ cohort can observe the counterfactual
    # neighborhood of the inflected side.
    sb = raw_pair_mode ? base    : lemma(base)
    sd = raw_pair_mode ? derived : lemma(derived)
    # For all cohorts, record whether +lemma()+ considers the pair identical.
    # In raw-mode cohorts this is the key field (defines the cohort by
    # construction); in default-mode cohorts it stratifies out tautological
    # jaccard=1.0 rows caused by pre-score lemma collapse.
    lemma_merged = (lemma(base) == lemma(derived)) ? 1 : 0
    transform = (cohort == "derivational" || cohort == "lemma_collapsed") ? derivational_transform_key(base, derived) : nil
    base_hits = []
    derived_hits = []
    anchor_pool.each do |x|
      next if x == base || x == derived
      lx = lemma(x)
      base_hit = cached_score(sb, lx) >= thr ? 1 : 0
      derived_hit = cached_score(sd, lx) >= thr ? 1 : 0
      base_hits << base_hit
      derived_hits << derived_hit
      rows << {
        cohort: cohort,
        base: base,
        derived: derived,
        transform: transform,
        lemma_merged: lemma_merged,
        raw_pair_mode: raw_pair_mode ? 1 : 0,
        anchor: x,
        base_related: base_hit,
        derived_related: derived_hit,
      }
    end

    n = base_hits.size
    next if n.zero?
    agree_bool = base_hits.zip(derived_hits).count { |a, b| a == b }.to_f / n
    set_b = base_hits.each_index.select { |i| base_hits[i] == 1 }.to_set
    set_d = derived_hits.each_index.select { |i| derived_hits[i] == 1 }.to_set
    union_sz = (set_b | set_d).size
    jaccard = union_sz.zero? ? nil : (set_b & set_d).size.to_f / union_sz

    cohort_pair_stats[cohort] << {
      base: base,
      derived: derived,
      transform: transform,
      lemma_merged: lemma_merged,
      raw_pair_mode: raw_pair_mode,
      n_anchors: n,
      n_base_related: set_b.size,
      n_derived_related: set_d.size,
      n_both_related: (set_b & set_d).size,
      n_either_related: union_sz,
      agreement: agree_bool,
      jaccard: jaccard,
    }

    next unless ((idx + 1) % 50).zero? || idx == pairs.size - 1
    puts format("  %-16s %3d/%3d  (%.1fs elapsed)", cohort, idx + 1, pairs.size, Time.now - t0)
  end
end

# --- Output --------------------------------------------------------------------

FileUtils.mkdir_p(File.dirname(output_path))
CSV.open(output_path, "w") do |csv|
  csv << rows.first.keys if rows.any?
  rows.each { |r| csv << r.values }
end
puts "\nWrote #{rows.size} rows to #{output_path}"

puts "\nPer-cohort summary (Boolean-only):"
puts format("  %-38s %-5s %-27s %-27s",
  "cohort", "n", "agreement (p25/med/p75)", "jaccard (p25/med/p75)")
# Split the derivational cohort on +lemma_merged+ so the artifactual
# "jaccard=1.0 because lemma() already collapsed them" pairs don't mask the
# real signal from pairs the merge would actually affect. The
# +lemma_collapsed+ cohort doesn't need the split: by construction every pair
# has +lemma_merged=1+, but scoring is done in raw mode so jaccard is NOT a
# tautology — it measures whether the inflected form's neighborhood (when not
# collapsed) differs from the base's.
rendered = []
cohort_pair_stats.each do |cohort, stats|
  if cohort == "derivational"
    lemma_kept, lemma_collapsed = stats.partition { |s| s[:lemma_merged].zero? }
    rendered << ["derivational (lemma-distinct)", lemma_kept]
    rendered << ["derivational (already-merged)", lemma_collapsed]
  elsif cohort == "lemma_collapsed"
    rendered << ["lemma_collapsed (raw-mode scoring)", stats]
  else
    rendered << [cohort, stats]
  end
end
rendered.each do |label, stats|
  agree = stats.map { |s| s[:agreement] }.compact
  jac = stats.map { |s| s[:jaccard] }.compact
  puts format(
    "  %-38s %-5d %6.3f / %6.3f / %6.3f    %6.3f / %6.3f / %6.3f",
    label, stats.size,
    percentile(agree, 25) || 0, percentile(agree, 50) || 0, percentile(agree, 75) || 0,
    percentile(jac, 25) || 0, percentile(jac, 50) || 0, percentile(jac, 75) || 0,
  )
end

# Signal-mass asymmetry diagnostic: for each pair, median positive counts on
# each side and the fraction of pairs where the "derived" (right-hand) side
# has FEWER than half the positive anchors of the "base" (left-hand) side.
# Relevant because a raw-mode scored inflected form (e.g. +shorthairs+,
# +grammars+) often has no Numberbatch vector of its own, so its neighborhood
# is nearly empty and low Jaccard doesn't mean "merge destroys signal" — it
# means "inflected form has no standalone signal, canonicalization is the
# ONLY path to any neighborhood at all". Without this stat, the lemma_collapsed
# results look misleadingly damning.
puts "\nPer-cohort signal-mass diagnostic (positive anchors):"
puts format("  %-38s %-5s %-14s %-14s %s",
  "cohort", "n", "base_pos (med)", "derv_pos (med)", "%pairs derv<half·base")
rendered.each do |label, stats|
  next if stats.empty?
  base_pos = stats.map { |s| s[:n_base_related] }
  derv_pos = stats.map { |s| s[:n_derived_related] }
  undermass = stats.count { |s|
    # count pairs where the right-hand side has noticeably less signal than
    # the left; only meaningful when the left has enough signal to compare
    # against (>=2 positives).
    s[:n_base_related] >= 2 && s[:n_derived_related] < s[:n_base_related] / 2.0
  }
  puts format("  %-38s %-5d %-14d %-14d %.1f%%",
    label, stats.size,
    percentile(base_pos, 50) || 0,
    percentile(derv_pos, 50) || 0,
    100.0 * undermass / stats.size,
  )
end

# --- Per-transform stratification --------------------------------------------
#
# Two side-by-side tables:
#
#   1. Derivational (lemma-distinct): pairs the current lemma map does NOT
#      collapse. Measures "would adding a new merge rule for this transform
#      preserve neighborhoods?" High median Jaccard = plausibly safe to merge.
#
#   2. Lemma-collapsed (raw-mode scoring): pairs the current lemma map DOES
#      collapse. Measures "does the existing merge preserve neighborhoods,
#      compared to what the inflected form would look like on its own?"
#      High median Jaccard = current merge is harmless. Low = the lemma map is
#      discarding real distinctional signal.
#
# Surface transform groups keep +ly, +ing etc. separate from +ness, +ic, etc.
# so inflectional patterns (expected safe) don't mask derivational ones.

def build_transform_summaries(stats, exclude_already_merged:)
  by_transform = Hash.new { |h, k| h[k] = [] }
  n_skipped = 0
  stats.each do |s|
    if exclude_already_merged && s[:lemma_merged].to_i == 1
      n_skipped += 1
      next
    end
    by_transform[s[:transform]] << s
  end
  summaries = by_transform.map do |transform, ss|
    jac = ss.map { |s| s[:jaccard] }.compact
    agree = ss.map { |s| s[:agreement] }.compact
    {
      transform: transform,
      n_pairs: ss.size,
      median_jaccard: percentile(jac, 50),
      p25_jaccard: percentile(jac, 25),
      p75_jaccard: percentile(jac, 75),
      median_agreement: percentile(agree, 50),
      example_pairs: ss.sort_by { |s| -(s[:jaccard] || 0) }.first(2).map { |s| "#{s[:base]}/#{s[:derived]}=#{format('%.2f', s[:jaccard] || 0)}" },
      worst_pairs: ss.sort_by { |s| (s[:jaccard] || 1.0) }.first(2).map { |s| "#{s[:base]}/#{s[:derived]}=#{format('%.2f', s[:jaccard] || 0)}" },
    }
  end
  [summaries, n_skipped]
end

def print_transform_table(label, summaries)
  puts "\n#{label} — per-transform sub-summary (n >= 3), sorted by median Jaccard desc:"
  puts format("  %-20s %-5s %-25s %-10s %s",
    "transform", "n", "jaccard (p25/med/p75)", "agree(med)", "top / worst examples")
  summaries
    .select { |s| s[:n_pairs] >= 3 }
    .sort_by { |s| [-(s[:median_jaccard] || -1.0), -s[:n_pairs]] }
    .each do |s|
      puts format(
        "  %-20s %-5d %5.2f / %5.2f / %5.2f       %5.2f     %s  |  %s",
        s[:transform], s[:n_pairs],
        s[:p25_jaccard] || 0, s[:median_jaccard] || 0, s[:p75_jaccard] || 0,
        s[:median_agreement] || 0,
        s[:example_pairs].join("  "),
        s[:worst_pairs].join("  "),
      )
    end
  rare = summaries.select { |s| s[:n_pairs] < 3 }.sort_by { |s| -(s[:median_jaccard] || 0) }
  if rare.any?
    puts "\n#{label} — rare transforms (n < 3; noisy, not basis for conclusions):"
    puts format("  %-20s %-5s %-15s %s", "transform", "n", "median_jaccard", "examples")
    rare.first(20).each do |s|
      puts format("  %-20s %-5d %-15.3f %s",
        s[:transform], s[:n_pairs], s[:median_jaccard] || 0,
        s[:example_pairs].join("  "))
    end
  end
end

def print_band_histogram(label, summaries, high_meaning, low_meaning)
  safe_count = summaries.count { |s| s[:n_pairs] >= 3 && (s[:median_jaccard] || 0) >= 0.8 }
  mid_count  = summaries.count { |s| s[:n_pairs] >= 3 && (s[:median_jaccard] || 0).between?(0.5, 0.8) }
  low_count  = summaries.count { |s| s[:n_pairs] >= 3 && (s[:median_jaccard] || 0) < 0.5 }
  puts "\n#{label} — transforms (n >= 3) by Jaccard band:"
  puts "  >=0.80 (#{high_meaning}):  #{safe_count}"
  puts "  0.50-0.80 (borderline):    #{mid_count}"
  puts "  <0.50 (#{low_meaning}):    #{low_count}"
end

deriv_summaries, n_deriv_skipped = build_transform_summaries(
  cohort_pair_stats["derivational"], exclude_already_merged: true
)
puts "\n(Derivational: excluded #{n_deriv_skipped} already-lemmatized pairs — their jaccard=1.0 is a tautology, not evidence.)"
print_transform_table("Derivational (lemma-distinct)", deriv_summaries)
print_band_histogram("Derivational (lemma-distinct)", deriv_summaries,
  "plausibly safe to merge", "unsafe to merge")

# Lemma-collapsed cohort: every pair already has +lemma_merged=1+, but scoring
# used raw surface forms so +jaccard+ is measured across genuinely distinct
# +rel(W, X)+ and +rel(base, X)+ vectors — no tautology to exclude.
lemma_summaries, _ = build_transform_summaries(
  cohort_pair_stats["lemma_collapsed"], exclude_already_merged: false
)
print_transform_table("Lemma-collapsed (existing merges, raw-scored)", lemma_summaries)
print_band_histogram("Lemma-collapsed (existing merges, raw-scored)", lemma_summaries,
  "merge preserves neighborhood", "merge discards signal")
