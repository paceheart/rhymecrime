#!/usr/bin/env ruby
# frozen_string_literal: true
#
# Re-runs the syllabification routines on the inputs that the current
# +generated/word_dict.txt+ records as violating the syllable-vowel
# invariant, and checks the *new* code produces invariant-clean output.
#
# Doesn't touch the dict on disk; this is a regression guard you can run
# without paying for a full +bin/dict-build+. Companion to
# +bin/audit-syllable-vowel-invariant+: that one audits the saved dict,
# this one audits the live code against the saved dict's faulty cases.
#
# For COMMON_PREFIXES violations: simulates +syllabify_with_common_prefix_split+
# by stripping +.+ from the violating pron, picking off the matching prefix,
# and looking the stem's flat phonemes up in the same dict (just like dict-build does).
#
# For non-prefix violations: simulates +Pronunciation#syllabify+ on the
# dot-stripped flat phonemes.

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "rhymecrime/dict/phoneme"
require "rhymecrime/dict/pronunciation"
require "rhymecrime/dict/utils_rhyme"
require "rhymecrime/dict/phonology"

WORD_DICT_PATH = File.expand_path("../generated/word_dict.txt", __dir__)
PREFIXES_BY_LEN = COMMON_PREFIXES.sort_by { |p| -p.length }

flat_by_word = Hash.new { |h, k| h[k] = [] }
File.foreach(WORD_DICT_PATH, encoding: "UTF-8") do |line|
  line.chomp!
  next if line.empty? || line.start_with?("#")
  cols = line.split(",", 4)
  word = cols[0]
  pron_field = cols[2].to_s
  next if pron_field.empty?
  pron_field.split("|").each do |pron_str|
    flat = pron_str.split.reject { |ph| ph == "." }
    flat_by_word[word] << Pronunciation.new(flat)
  end
end
puts "loaded #{flat_by_word.size} words from saved dict"

prefix_pass = 0
prefix_fail = []
nonprefix_pass = 0
nonprefix_fail = []

# Read saved dict, pick out every violating pron, and re-syllabify with the
# live code. flat_by_word provides stem lookups for the prefix branch.
File.foreach(WORD_DICT_PATH, encoding: "UTF-8") do |line|
  line.chomp!
  next if line.empty? || line.start_with?("#")
  cols = line.split(",", 4)
  word = cols[0]
  pron_field = cols[2].to_s
  next if pron_field.empty?
  pron_field.split("|").each do |saved_pron_str|
    saved_pron = Pronunciation.new(saved_pron_str.split)
    next if saved_pron.syllable_vowel_invariant_ok?

    flat = saved_pron.phonemes.reject { |ph| ph == "." }
    new_pron = syllabify_with_common_prefix_split(word, Pronunciation.new(flat), flat_by_word)

    if PREFIXES_BY_LEN.find { |p| word.length > p.length && word.start_with?(p) }
      if new_pron.syllable_vowel_invariant_ok?
        prefix_pass += 1
      else
        prefix_fail << [word, saved_pron_str, new_pron.to_s,
                        new_pron.syllable_vowel_invariant_violation]
      end
    else
      if new_pron.syllable_vowel_invariant_ok?
        nonprefix_pass += 1
      else
        nonprefix_fail << [word, saved_pron_str, new_pron.to_s,
                           new_pron.syllable_vowel_invariant_violation]
      end
    end
  end
end

puts
puts "prefix-attributable cases:"
puts "  re-syllabified clean: #{prefix_pass}"
puts "  still violating:      #{prefix_fail.size}"
prefix_fail.first(20).each { |w, old, new_s, d| puts "    #{w}: #{old} -> #{new_s}  (#{d})" }
puts "    ... +#{prefix_fail.size - 20} more" if prefix_fail.size > 20

puts
puts "non-prefix cases:"
puts "  re-syllabified clean: #{nonprefix_pass}"
puts "  still violating:      #{nonprefix_fail.size}"
nonprefix_fail.each { |w, old, new_s, d| puts "    #{w}: #{old} -> #{new_s}  (#{d})" }

exit(prefix_fail.empty? && nonprefix_fail.empty? ? 0 : 1)
