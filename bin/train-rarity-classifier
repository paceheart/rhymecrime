#!/usr/bin/env ruby
# frozen_string_literal: true
#
# Train the rarity-scoring stage's learned scorer (replaces +compute_frequency+ /
# Wiktionary existence floor / +filter_word_dict_disconnected!+ rescue rules).
#
# Input:
#   generated/rarity_signals_dump.jsonl    built by running
#       RHYMECRIME_RARITY_DUMP_SIGNALS=<path> ./bin/dict-build
#     once with the classifier disabled. One record per headword:
#       {"word": "foo", "features": [...one float per feature, leading +1.0+ bias...], "freq": 10}
#     Feature ordering and count must match +LEARNED_RARITY_FEATURE_NAMES+ in
#     lib/rhymecrime/dict/rarity_classifier.rb. The +freq+ column is a
#     diagnostic only (referenced in confusion-row printout); for training
#     purposes the relevant freq lives inside +features+ as
#     +post_propagation_freq+.
#   curated/rarity.csv                     labeled rows (word, kind, ...).
#
# Output:
#   generated/rarity_classifier.json       best model on 5-fold CV weighted
#     accuracy. See +rarity_classify+ in lib/rhymecrime/dict/rarity_classifier.rb
#     for the consumer format.
#
# Training combos (3 total; the 2class target and the regressor-logreg variant
# were ablated — both consistently lost to 3class on cross-validated weighted
# accuracy and the inference paths weren't worth keeping alive):
#   3class-gbt     multiclass ∈ {common, rare, forbidden}. One-vs-rest binary
#                  GBT per class; softmax over logits at inference; argmax →
#                  label.
#   3class-logreg  same target, logistic-regression base learner.
#   regressor-gbt  single scalar target (forbidden=0, rare=2, common=10).
#                  Squared error with sample weights; two thresholds
#                  (+t_forbidden_rare+, +t_rare_common+) map score → label.
#
# Evaluation / selection: weighted accuracy using the same symmetric
# partial-credit matrix as spec/rarity_spec.rb (rare↔forbidden=0.9,
# common↔rare=0.1, common↔forbidden=0.0). Row weights 3 for strong labels,
# 1 for _ish.
#
#   ./bin/train-rarity-classifier                   # all 3 combos, pick winner
#   ./bin/train-rarity-classifier --only 3class-gbt # train one combo
#   ./bin/train-rarity-classifier --dry-run         # don't write json
#   ./bin/train-rarity-classifier --folds 5 --seed 42

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "csv"
require "json"
require "optparse"
require "set"

options = {
  folds: 5,
  seed: 42,
  dry_run: false,
  verbose: false,
  only: nil,
  ablate_group: nil,

  # logreg hyperparams
  epochs: 600,
  lr: 0.3,
  l2: 0.02,

  # gbt hyperparams
  trees: 200,
  depth: 4,
  gbt_lr: 0.1,
  lambda_leaf: 1.0,
  min_child_hessian: 5.0,
  colsample: 0.8,
}

OptionParser.new do |opt|
  opt.on("--folds N", Integer) { |v| options[:folds] = v }
  opt.on("--seed N", Integer) { |v| options[:seed] = v }
  opt.on("--dry-run") { options[:dry_run] = true }
  opt.on("--verbose") { options[:verbose] = true }
  opt.on("--only NAME") { |v| options[:only] = v }
  opt.on("--ablate-group NAMES", "comma-separated feature groups to zero out (engineered, post_propagation, wordnet, kaikki, corpus, shape, pos)") { |v| options[:ablate_group] = v.split(",").map(&:strip) }

  opt.on("--epochs N", Integer) { |v| options[:epochs] = v }
  opt.on("--lr F", Float) { |v| options[:lr] = v }
  opt.on("--l2 F", Float) { |v| options[:l2] = v }

  opt.on("--trees N", Integer) { |v| options[:trees] = v }
  opt.on("--depth N", Integer) { |v| options[:depth] = v }
  opt.on("--gbt-lr F", Float) { |v| options[:gbt_lr] = v }
  opt.on("--lambda-leaf F", Float) { |v| options[:lambda_leaf] = v }
  opt.on("--min-child-hessian F", Float) { |v| options[:min_child_hessian] = v }
  opt.on("--colsample F", Float) { |v| options[:colsample] = v }
end.parse!

repo = File.expand_path("..", __dir__)
Dir.chdir(repo)

# Load constants + feature names without pulling in crime.rb (which loads the full
# dict; the trainer only needs the signal dump).
require "rhymecrime/dict/constants"
require "rhymecrime/dict/utils_rhyme"
require "rhymecrime/dict/rarity_classifier"

# --- Constants -------------------------------------------------------------

PARTIAL_CREDIT = {
  %i[common common]       => 1.0,
  %i[rare rare]           => 1.0,
  %i[forbidden forbidden] => 1.0,
  %i[common rare]         => 0.1,
  %i[rare common]         => 0.1,
  %i[rare forbidden]      => 0.9,
  %i[forbidden rare]      => 0.9,
  %i[common forbidden]    => 0.0,
  %i[forbidden common]    => 0.0,
}.freeze

CLASS_LABELS_3 = %w[forbidden rare common].freeze
FREQ_PER_CLASS = { "forbidden" => 0.0, "rare" => 2.0, "common" => 10.0 }.freeze

def kind_to_label(kind)
  case kind.strip
  when "common", "common_ish"       then "common"
  when "rare", "rare_ish"           then "rare"
  when "forbidden", "forbidden_ish" then "forbidden"
  else nil
  end
end

def row_weight(kind)
  kind.strip.end_with?("_ish") ? 1.0 : 3.0
end

def score_prediction(truth, predicted)
  PARTIAL_CREDIT.fetch([truth.to_sym, predicted.to_sym])
end

# --- Load dump and labels --------------------------------------------------

dump_path = File.join(repo, "generated", "rarity_signals_dump.jsonl")
unless File.exist?(dump_path)
  warn "missing signals dump: #{dump_path}"
  warn "produce it with:"
  warn "  RHYMECRIME_RARITY_DUMP_SIGNALS=#{dump_path} ./bin/dict-build"
  exit 1
end

dump_words = {}
File.foreach(dump_path, encoding: "UTF-8") do |line|
  rec = JSON.parse(line)
  dump_words[rec["word"]] = { features: rec["features"], freq: rec["freq"] }
end
puts "loaded signals dump: #{dump_words.size} words"

rarity_csv = File.join(repo, "curated", "rarity.csv")
raw_rows = CSV.read(rarity_csv, headers: true, encoding: "UTF-8")

labeled_rows = []
skipped_no_features = 0
skipped_no_kind = 0
skipped_skip = 0

raw_rows.each do |row|
  kind = row["kind"].to_s
  label = kind_to_label(kind)
  (skipped_no_kind += 1; next) if label.nil?
  (skipped_skip += 1; next) if row["skip"].to_s.strip == "1"

  word = row["word"].to_s
  rec = dump_words[word]
  if rec.nil?
    # Words the dict build never even considered — construct a zero-feature row so
    # the classifier still learns "totally-absent words are forbidden". Rarely
    # happens in practice (kaikki + cmudict + subtlex cover the test set).
    skipped_no_features += 1
    features = Array.new(LEARNED_RARITY_FEATURE_NAMES.size, 0.0)
    features[0] = 1.0
    freq = 0
  else
    features = rec[:features]
    freq = rec[:freq]
  end

  labeled_rows << {
    word: word,
    label: label,
    weight: row_weight(kind),
    features: features,
    freq: freq,
    kind: kind.strip,
  }
end

puts "labeled rows: #{labeled_rows.size}  (+#{skipped_no_kind} non-category, +#{skipped_skip} skip=1)"
puts "  class distribution:"
CLASS_LABELS_3.each do |c|
  n = labeled_rows.count { |r| r[:label] == c }
  n_ish = labeled_rows.count { |r| r[:label] == c && r[:kind].end_with?("_ish") }
  puts format("    %-10s  n=%4d  strong=%4d  ish=%4d", c, n, n - n_ish, n_ish)
end
puts "  #{skipped_no_features} labeled words missing from dump (using all-zero features)" if skipped_no_features > 0
puts "feature count: #{labeled_rows.first[:features].size} (expected #{LEARNED_RARITY_FEATURE_NAMES.size})"
unless labeled_rows.first[:features].size == LEARNED_RARITY_FEATURE_NAMES.size
  warn "feature count mismatch — did the dump come from a stale build?"
  exit 1
end

# Feature-group index map: lists of feature-names per group. Used by +--ablate-
# group+ to zero out groups before training so we can measure which groups pull
# their weight (re-run vs baseline weighted pct). Groups align with the sections
# of +RaritySignals+ in +lib/rhymecrime/dict/rarity_signals.rb+.
FEATURE_GROUPS = {
  # +common_words_flag+ / +rare_words_flag+ used to live here too — see the long
  # comment above +LEARNED_RARITY_FEATURE_NAMES+ in +rarity_classifier.rb+.
  "corpus"          => %w[wordfreq_zipf subtlex_freqlow subtlex_total subtlex_cap_ratio_present subtlex_cap_ratio cmudict_original_flag conceptnet_flag numberbatch_flag usf_flag neol_flag semantically_promiscuous_flag wiktionary_words_flag],
  "wordnet"         => %w[wn_entry_flag wn_synset_count wn_lemma_count wn_all_proper_flag wn_has_noun_flag wn_has_verb_flag wn_has_adj_flag],
  "graph_degree"    => %w[usf_out_degree cn_degree cn_adjacency_loaded_flag],
  "shape"           => %w[word_len two_letter_alpha_flag four_letter_alpha_flag likely_proper_noun_by_case_flag],
  "pos"             => %w[pos_tag_count pos_has_noun_flag pos_has_verb_flag pos_has_adj_flag pos_has_intj_flag pos_all_function_word_flag],
  "post_propagation" => %w[post_propagation_freq log_post_propagation_freq is_rare_by_freq_flag freq_source_phase_index received_donor_from_common_base_flag],
}.freeze

if options[:ablate_group]
  ablated_names = options[:ablate_group].flat_map { |g| FEATURE_GROUPS.fetch(g) { raise "unknown feature group: #{g}" } }.uniq
  idxs = ablated_names.map { |n| LEARNED_RARITY_FEATURE_NAMES.index(n) or raise "missing feature: #{n}" }
  puts "ablating #{ablated_names.size} features (groups=#{options[:ablate_group].join(',')}): zeroing columns #{idxs.sort.join(', ')}"
  labeled_rows.each do |r|
    feats = r[:features].dup
    idxs.each { |i| feats[i] = 0.0 }
    r[:features] = feats
  end
end
puts

# --- Shared math helpers ---------------------------------------------------

def sigmoid(z)
  if z >= 0
    1.0 / (1.0 + Math.exp(-z))
  else
    ez = Math.exp(z)
    ez / (1.0 + ez)
  end
end

def softmax(logits)
  mx = logits.max
  exps = logits.map { |z| Math.exp(z - mx) }
  s = exps.sum
  exps.map { |e| e / s }
end

# --- Logistic regression (binary) ------------------------------------------

# Standardize columns 1..d-1 in-place (skip bias at column 0). Returns [means, stds].
def standardize!(rows)
  d = rows.first.size
  means = Array.new(d, 0.0)
  stds = Array.new(d, 1.0)
  n = rows.size.to_f
  (1...d).each do |j|
    s = 0.0
    rows.each { |r| s += r[j] }
    means[j] = s / n
    sq = 0.0
    rows.each { |r| sq += (r[j] - means[j])**2 }
    stds[j] = Math.sqrt(sq / n)
    stds[j] = 1.0 if stds[j] < 1e-9
  end
  rows.each do |r|
    (1...d).each { |j| r[j] = (r[j] - means[j]) / stds[j] }
  end
  [means, stds]
end

def fit_logreg_binary(x_rows, y, sample_weights, lr:, l2:, epochs:)
  n = x_rows.size
  d = x_rows.first.size
  w = Array.new(d, 0.0)
  w_sum_total = sample_weights.sum.to_f

  prev_loss = Float::INFINITY
  epochs.times do |epoch|
    grad = Array.new(d, 0.0)
    loss = 0.0
    n.times do |i|
      x = x_rows[i]
      z = 0.0
      d.times { |j| z += w[j] * x[j] }
      p = sigmoid(z)
      sw = sample_weights[i]
      pc = [[p, 1e-12].max, 1 - 1e-12].min
      loss += -sw * (y[i] * Math.log(pc) + (1 - y[i]) * Math.log(1 - pc))
      err = p - y[i]
      d.times { |j| grad[j] += sw * err * x[j] }
    end
    (1...d).each { |j| grad[j] += l2 * w[j] }

    step = lr / w_sum_total
    d.times { |j| w[j] -= step * grad[j] }

    delta = (prev_loss - loss).abs / [prev_loss.abs, 1.0].max
    break if delta < 1e-7 && epoch > 10
    prev_loss = loss
  end
  w
end

def predict_linreg(raw_row, w, means, stds)
  z = 0.0
  raw_row.each_with_index do |v, j|
    x = j.zero? ? v : (v - means[j]) / stds[j]
    z += w[j] * x
  end
  z
end

# --- GBT (binary classification + regression) ------------------------------

def find_best_split_gbt(x_rows, g, h, feature_indices, rows, total_g, total_h, lambda_leaf:, min_child_hessian:)
  base_gain = total_g**2 / (total_h + lambda_leaf)
  best = nil
  best_gain = 0.0

  feature_indices.each do |f|
    sorted = rows.sort_by { |i| x_rows[i][f] }
    g_l = 0.0
    h_l = 0.0
    sz = sorted.size

    (0...sz - 1).each do |k|
      i = sorted[k]
      g_l += g[i]
      h_l += h[i]
      h_r = total_h - h_l
      next if h_l < min_child_hessian || h_r < min_child_hessian

      v_cur = x_rows[i][f]
      v_next = x_rows[sorted[k + 1]][f]
      next if v_cur == v_next

      g_r = total_g - g_l
      gain = g_l**2 / (h_l + lambda_leaf) + g_r**2 / (h_r + lambda_leaf) - base_gain
      if gain > best_gain
        best_gain = gain
        best = { feature: f, threshold: (v_cur + v_next) / 2.0 }
      end
    end
  end
  best
end

def build_tree_gbt(nodes, x_rows, g, h, features, rows, depth, max_depth, lambda_leaf, min_child_hessian)
  total_g = 0.0
  total_h = 0.0
  rows.each do |i|
    total_g += g[i]
    total_h += h[i]
  end

  split = nil
  if depth < max_depth && rows.size >= 2 && total_h >= 2 * min_child_hessian
    split = find_best_split_gbt(
      x_rows, g, h, features, rows, total_g, total_h,
      lambda_leaf: lambda_leaf, min_child_hessian: min_child_hessian
    )
  end

  if split.nil?
    leaf_value = -total_g / (total_h + lambda_leaf)
    idx = nodes.size
    nodes << { "v" => leaf_value }
    return idx
  end

  left_rows = []
  right_rows = []
  f = split[:feature]
  t = split[:threshold]
  rows.each do |i|
    (x_rows[i][f] <= t ? left_rows : right_rows) << i
  end

  if left_rows.empty? || right_rows.empty?
    leaf_value = -total_g / (total_h + lambda_leaf)
    idx = nodes.size
    nodes << { "v" => leaf_value }
    return idx
  end

  idx = nodes.size
  nodes << { "f" => f, "t" => t, "l" => nil, "r" => nil }
  nodes[idx]["l"] = build_tree_gbt(nodes, x_rows, g, h, features, left_rows, depth + 1, max_depth, lambda_leaf, min_child_hessian)
  nodes[idx]["r"] = build_tree_gbt(nodes, x_rows, g, h, features, right_rows, depth + 1, max_depth, lambda_leaf, min_child_hessian)
  idx
end

def tree_predict(nodes, row)
  idx = 0
  loop do
    n = nodes[idx]
    return n["v"] if n.key?("v")
    idx = row[n["f"]] <= n["t"] ? n["l"] : n["r"]
  end
end

def fit_gbt_binary(x_rows, y, sample_weights, trees:, depth:, lr:, lambda_leaf:, min_child_hessian:, colsample:, seed:)
  n = x_rows.size
  d = x_rows.first.size
  rng = Random.new(seed)
  sum_w = sample_weights.sum.to_f
  sum_wy = 0.0
  n.times { |i| sum_wy += sample_weights[i] * y[i] }
  p0 = sum_wy / sum_w
  p0 = [[p0, 1e-4].max, 1 - 1e-4].min
  bias = Math.log(p0 / (1 - p0))
  margins = Array.new(n, bias)
  ensemble = []
  all_features = (1...d).to_a

  trees.times do
    g = Array.new(n)
    h = Array.new(n)
    n.times do |i|
      p = sigmoid(margins[i])
      sw = sample_weights[i]
      g[i] = sw * (p - y[i])
      h[i] = sw * p * (1 - p)
    end

    feats = colsample < 1.0 ? all_features.sample([(all_features.size * colsample).ceil, 1].max, random: rng) : all_features
    nodes = []
    build_tree_gbt(nodes, x_rows, g, h, feats, (0...n).to_a, 0, depth, lambda_leaf, min_child_hessian)
    n.times { |i| margins[i] += lr * tree_predict(nodes, x_rows[i]) }
    ensemble << nodes
  end
  [bias, ensemble]
end

def fit_gbt_regression(x_rows, y, sample_weights, trees:, depth:, lr:, lambda_leaf:, min_child_hessian:, colsample:, seed:)
  n = x_rows.size
  d = x_rows.first.size
  rng = Random.new(seed)
  sum_w = sample_weights.sum.to_f
  sum_wy = 0.0
  n.times { |i| sum_wy += sample_weights[i] * y[i] }
  bias = sum_wy / sum_w
  preds = Array.new(n, bias)
  ensemble = []
  all_features = (1...d).to_a

  trees.times do
    g = Array.new(n)
    h = Array.new(n)
    n.times do |i|
      sw = sample_weights[i]
      g[i] = sw * (preds[i] - y[i])
      h[i] = sw
    end

    feats = colsample < 1.0 ? all_features.sample([(all_features.size * colsample).ceil, 1].max, random: rng) : all_features
    nodes = []
    build_tree_gbt(nodes, x_rows, g, h, feats, (0...n).to_a, 0, depth, lambda_leaf, min_child_hessian)
    n.times { |i| preds[i] += lr * tree_predict(nodes, x_rows[i]) }
    ensemble << nodes
  end
  [bias, ensemble]
end

def predict_gbt_margin(raw_row, bias, trees, lr)
  s = bias
  trees.each { |t| s += lr * tree_predict(t, raw_row) }
  s
end

# --- Fold splitting --------------------------------------------------------

def make_folds(n, k, seed)
  rng = Random.new(seed)
  indices = (0...n).to_a.shuffle(random: rng)
  folds = Array.new(k) { [] }
  indices.each_with_index { |idx, i| folds[i % k] << idx }
  folds
end

# --- Per-target training helpers -------------------------------------------

# Returns a closure +predict_label(features)+ that takes a raw feature row and
# returns one of "common" / "rare" / "forbidden".
# Also returns the serializable-model hash (saved to json for deployment).

def train_3class(labeled_rows, train_ids, model_type, options)
  classes = CLASS_LABELS_3
  d = labeled_rows.first[:features].size
  per_class = {}
  per_class_raw = {}

  classes.each do |c|
    y = train_ids.map { |i| labeled_rows[i][:label] == c ? 1.0 : 0.0 }
    sw = train_ids.map { |i| labeled_rows[i][:weight] }
    case model_type
    when "logreg"
      x = train_ids.map { |i| labeled_rows[i][:features].dup }
      means, stds = standardize!(x)
      w = fit_logreg_binary(x, y, sw, lr: options[:lr], l2: options[:l2], epochs: options[:epochs])
      per_class[c] = { "means" => means, "stds" => stds, "weights" => w }
    when "gbt"
      x = train_ids.map { |i| labeled_rows[i][:features] }
      bias, trees = fit_gbt_binary(x, y, sw, trees: options[:trees], depth: options[:depth], lr: options[:gbt_lr], lambda_leaf: options[:lambda_leaf], min_child_hessian: options[:min_child_hessian], colsample: options[:colsample], seed: options[:seed] + classes.index(c))
      per_class[c] = { "bias" => bias, "lr" => options[:gbt_lr], "trees" => trees }
    else raise "bad model_type: #{model_type}"
    end
  end

  predict = lambda do |feats|
    logits = classes.map do |c|
      case model_type
      when "logreg" then predict_linreg(feats, per_class[c]["weights"], per_class[c]["means"], per_class[c]["stds"])
      when "gbt"    then predict_gbt_margin(feats, per_class[c]["bias"], per_class[c]["trees"], per_class[c]["lr"])
      end
    end
    probs = softmax(logits)
    classes[probs.each_with_index.max_by { |p, _| p }[1]]
  end

  model_data = {
    "target" => "3class",
    "model_type" => model_type,
    "classes" => classes,
    "models" => per_class,
  }
  [predict, model_data]
end

# Regressor is GBT-only — the logreg variant lost to 3class on every fold and
# the runtime never had a dispatch for it (the +regressor+ inference path in
# +rarity_classify+ unconditionally calls the GBT scorer). Keeping just the
# GBT path here keeps the trainer in lock-step with what the runtime can load.
def train_regressor(labeled_rows, train_ids, options)
  y = train_ids.map { |i| FREQ_PER_CLASS[labeled_rows[i][:label]] }
  sw = train_ids.map { |i| labeled_rows[i][:weight] }
  x = train_ids.map { |i| labeled_rows[i][:features] }

  bias, trees = fit_gbt_regression(x, y, sw, trees: options[:trees], depth: options[:depth], lr: options[:gbt_lr], lambda_leaf: options[:lambda_leaf], min_child_hessian: options[:min_child_hessian], colsample: options[:colsample], seed: options[:seed])
  payload = { "bias" => bias, "lr" => options[:gbt_lr], "trees" => trees }

  t_fr = 1.0
  t_rc = 6.0

  predict = lambda do |feats|
    s = predict_gbt_margin(feats, payload["bias"], payload["trees"], payload["lr"])
    if s < t_fr then "forbidden"
    elsif s < t_rc then "rare"
    else "common"
    end
  end

  model_data = {
    "target" => "regressor",
    "model_type" => "gbt",
    "t_forbidden_rare" => t_fr,
    "t_rare_common" => t_rc,
  }.merge(payload)
  [predict, model_data]
end

# --- Evaluation ------------------------------------------------------------

def evaluate(labeled_rows, eval_ids, predict_label)
  total_w = 0.0
  score = 0.0
  confusion = Hash.new(0)
  eval_ids.each do |i|
    row = labeled_rows[i]
    pred = predict_label.call(row[:features])
    w = row[:weight]
    total_w += w
    score += w * score_prediction(row[:label], pred)
    confusion[[row[:label], pred]] += 1
  end
  { weighted_pct: 100.0 * score / total_w, weighted_score: score, weighted_total: total_w, confusion: confusion }
end

# --- Run CV across all 3 combos --------------------------------------------

# Explicit combo list — was a target × model_type cross-product before the
# 2class and regressor-logreg variants were ablated; left as a literal so
# adding/dropping a combo is a one-line change without revisiting dispatch.
combos = %w[3class-gbt 3class-logreg regressor-gbt]
combos = combos.select { |c| c == options[:only] } if options[:only]

folds = make_folds(labeled_rows.size, options[:folds], options[:seed])
cv_results = {}

combos.each do |combo|
  target, model_type = combo.split("-")

  puts "=== #{combo}  #{options[:folds]}-fold CV ==="
  fold_scores = []
  folds.each_with_index do |test_ids, fi|
    train_ids = folds.each_with_index.flat_map { |f, i| i == fi ? [] : f }

    predict, _ = case target
                 when "3class"    then train_3class(labeled_rows, train_ids, model_type, options)
                 when "regressor" then train_regressor(labeled_rows, train_ids, options)
                 end

    r = evaluate(labeled_rows, test_ids, predict)
    fold_scores << r
    puts format("  fold %d  weighted=%.2f%%  (%.1f / %.0f)", fi, r[:weighted_pct], r[:weighted_score], r[:weighted_total])
  end
  total_score = fold_scores.sum { |r| r[:weighted_score] }
  total_w = fold_scores.sum { |r| r[:weighted_total] }
  pooled_pct = 100.0 * total_score / total_w
  cv_results[combo] = pooled_pct
  puts format("  CV pooled = %.2f%%", pooled_pct)
  puts
end

# --- Pick winner + final fit -----------------------------------------------

winner = cv_results.max_by { |_, v| v }
puts "=== CV ranking ==="
cv_results.sort_by { |_, v| -v }.each { |name, pct| puts format("  %-20s  %.2f%%", name, pct) }
puts
puts "winner: #{winner[0]}  (#{format('%.2f%%', winner[1])})"
puts

target, model_type = winner[0].split("-")
all_ids = (0...labeled_rows.size).to_a

predict, model_data = case target
                      when "3class"    then train_3class(labeled_rows, all_ids, model_type, options)
                      when "regressor" then train_regressor(labeled_rows, all_ids, options)
                      end

in_sample = evaluate(labeled_rows, all_ids, predict)
puts format("in-sample: weighted=%.2f%%", in_sample[:weighted_pct])
puts

puts "=== full-data confusion matrix (rows=truth, cols=pred) ==="
printf "  %-10s", ""
CLASS_LABELS_3.each { |c| printf "%-10s ", c }
puts
CLASS_LABELS_3.each do |t|
  printf "  %-10s", t
  CLASS_LABELS_3.each { |p| printf "%-10d ", in_sample[:confusion][[t, p]] }
  puts
end
puts

worst = labeled_rows.map { |r| [r, score_prediction(r[:label], predict.call(r[:features]))] }
               .reject { |_, s| s == 1.0 }
               .sort_by { |r, s| [s, -r[:weight]] }
puts "=== worst-scoring rows (top 30) ==="
worst.first(30).each do |r, s|
  pred = predict.call(r[:features])
  puts format("  score=%.1f  %-25s truth=%-10s pred=%-10s  kind=%s  freq=%d", s, r[:word], r[:label], pred, r[:kind], r[:freq])
end
puts

# --- Serialize -------------------------------------------------------------

out = model_data.merge(
  "feature_names" => LEARNED_RARITY_FEATURE_NAMES,
  "training" => {
    "winner" => winner[0],
    "cv_weighted_pct" => winner[1],
    "all_cv_results" => cv_results,
    "in_sample_weighted_pct" => in_sample[:weighted_pct],
    "rows" => labeled_rows.size,
    "folds" => options[:folds],
    "seed" => options[:seed],
    "trees" => options[:trees],
    "depth" => options[:depth],
    "gbt_lr" => options[:gbt_lr],
    "lambda_leaf" => options[:lambda_leaf],
    "min_child_hessian" => options[:min_child_hessian],
    "colsample" => options[:colsample],
    "epochs" => options[:epochs],
    "lr" => options[:lr],
    "l2" => options[:l2],
  },
)

if options[:dry_run]
  puts "(--dry-run: not writing output file)"
else
  out_path = generated_dict_path(RARITY_CLASSIFIER_FILENAME)
  File.write(out_path, JSON.generate(out), encoding: "UTF-8")
  size_kb = File.size(out_path) / 1024.0
  puts format("wrote %s (%.1f KB)", out_path, size_kb)
end
