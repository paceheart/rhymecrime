#!/usr/bin/env ruby
# frozen_string_literal: true
#
# Train the score-combination stage's learned combiner for thematic relatedness.
#
# Input:  curated/related.csv  (gold-labeled pairs: related / related_ish / unrelated / unrelated_ish / whatever)
# Output: generated/relatedness_classifier.json
#           common: { feature_names, model_type, threshold, training }
#           logreg: { means, stds, weights }
#           gbt:    { bias, lr, tree_format: "parallel_v1",
#                     trees: [ { f: [...], t: [...], l: [...], r: [...] }, ... ] }
#             Parallel arrays per tree (one entry per node, pre-order). f[i] == -1
#             marks a leaf and t[i] carries the leaf value (threshold and value
#             share the same float slot — they're never both meaningful). l[i] /
#             r[i] are child node indices for internal nodes, unused for leaves.
#
# Two supported model types (--model):
#   logreg  L2-regularized logistic regression (linear combiner, small file, fast).
#   gbt     Gradient-boosted regression trees (histogram-free exact splits, binary
#           logistic loss, Newton-step leaves, L2 on leaves, shrinkage). Captures
#           signal interactions that logistic regression can't. Larger JSON (~100KB
#           per 200 trees × depth 4) and ~1ms per pair at inference.
#
# Both optimize weighted log-loss. Base sample weights capture the "strong vs ish"
# confidence asymmetry (strong = 3, ish = 1). The --fn-weight knob (default
# 1.0, i.e. class-balanced — equal treatment of related vs. unrelated rows;
# distinct from the (cue, related) orientation, which the directional unfolds
# in learned_feature_vector already expose) further multiplies positive-class
# rows, turning the historical 3:1 pro-positive pull into an adjustable lever.
# After fitting, sweeps the decision threshold over [0.05, 0.95] and picks the
# probability cutoff maximizing composite; --fn-penalty (default 1.0)
# independently scales the FN terms in that composite so threshold-selection
# class asymmetry can be tuned apart from fit class asymmetry. Historical
# behavior is reproducible with --fn-weight 3 --fn-penalty 3 and was identified
# as a major driver of thematic-relatedness overgeneration (see notes/todo.md).
#
# Reports N-fold CV composite for an honest generalization estimate, then fits once
# on the full labeled set for deployment.
#
#   ruby bin/train-relatedness-classifier                    # gbt (default)
#   ruby bin/train-relatedness-classifier --model logreg
#   ruby bin/train-relatedness-classifier --model gbt --trees 400 --depth 5
#   ruby bin/train-relatedness-classifier --fn-weight 3 --fn-penalty 3  # pre-2026 class asymmetry
#   ruby bin/train-relatedness-classifier --threshold 0.43   # pin cutoff (skip sweep)
#   ruby bin/train-relatedness-classifier --dry-run
#
# After training, run bundle exec rspec spec/related_spec.rb to see the lift
# (default RELATED_LEARNED_MODE=additive; =replace for pure learned combiner).
# The spec evaluates with class-balanced scoring (3:1 strong vs ish, FN==FP); to
# compare apples-to-apples with a --fn-weight 3 --fn-penalty 3 training run,
# write a one-off evaluator that re-weights the per-row composites — the spec
# deliberately doesn't bake training-time class asymmetry into its pass criterion.

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "csv"
require "json"
require "optparse"

options = {
  model: "gbt",
  folds: 5,
  seed: 42,
  dry_run: false,
  verbose: false,

  # Class-asymmetry knobs (positive vs. negative rows — orthogonal to the
  # (cue, related) orientation, which is asymmetric and exposed via the
  # directional unfolds in learned_feature_vector). Historical behavior of
  # this script was fn_weight = fn_penalty = 3 (sample weights 9/3/3/1,
  # composite −9/−3/−3/−1), which compounded a ~3× positive pull in the fit
  # with a matching 3× FN:FP skew in the threshold sweep. That stacked bias
  # was identified as a major driver of thematic-relatedness overgeneration;
  # defaults are now class-balanced (1.0 each) and the old behavior is
  # reproducible with --fn-weight 3 --fn-penalty 3. spec/related_spec.rb
  # evaluates with class-balanced scoring; if a future experiment wants to
  # eval against asymmetric training, fork the spec or write a one-off.
  fn_weight: 1.0,   # sample-weight multiplier on positive-class rows (strong_pos / ish_pos)
  fn_penalty: 1.0,  # composite-score multiplier on FN terms during threshold selection

  # logreg hyperparams
  epochs: 600,
  lr: 0.3,
  l2: 0.02,

  # gbt hyperparams
  trees: 200,
  depth: 3,
  gbt_lr: 0.1,
  lambda_leaf: 1.0,
  min_child_hessian: 5.0,
  colsample: 0.8,
}

OptionParser.new do |opt|
  opt.on("--model MODEL", %w[logreg gbt]) { |v| options[:model] = v }
  opt.on("--folds N", Integer) { |v| options[:folds] = v }
  opt.on("--seed N", Integer) { |v| options[:seed] = v }
  opt.on("--dry-run") { options[:dry_run] = true }
  opt.on("--verbose") { options[:verbose] = true }
  # Override the auto-selected probability cutoff. Default (nil) keeps the
  # historical behavior of sweeping best_threshold over the in-sample fit and
  # picking the composite-maximum. Useful when you want to lock the FE/eval
  # boundary to a known-good prior (e.g. the 0.43 cutoff that produced 91.7%
  # before the latest data churn) without resurrecting the entire model file.
  opt.on("--threshold F", Float) { |v| options[:threshold] = v }

  opt.on("--fn-weight F", Float) { |v| options[:fn_weight] = v }
  opt.on("--fn-penalty F", Float) { |v| options[:fn_penalty] = v }

  opt.on("--epochs N", Integer) { |v| options[:epochs] = v }
  opt.on("--lr F", Float) { |v| options[:lr] = v }
  opt.on("--l2 F", Float) { |v| options[:l2] = v }

  opt.on("--trees N", Integer) { |v| options[:trees] = v }
  opt.on("--depth N", Integer) { |v| options[:depth] = v }
  opt.on("--gbt-lr F", Float) { |v| options[:gbt_lr] = v }
  opt.on("--lambda-leaf F", Float) { |v| options[:lambda_leaf] = v }
  opt.on("--min-child-hessian F", Float) { |v| options[:min_child_hessian] = v }
  opt.on("--colsample F", Float) { |v| options[:colsample] = v }
end.parse!

ENV.delete("RHYMECRIME_DATA_SOURCE")

repo = File.expand_path("..", __dir__)
Dir.chdir(repo)

require "rhymecrime/crime"
# Full-compute pipeline (Numberbatch, ConceptNet, WordNet, USF, MPNet) — not
# loaded at Lambda runtime by rhymecrime/crime, explicitly pulled in here
# because the trainer's whole job is to consume these signals.
require "rhymecrime/relatedness/signals"
require "rhymecrime/relatedness/score"

# --- Common helpers ---------------------------------------------------------

def sigmoid(z)
  if z >= 0
    ez = Math.exp(-z)
    1.0 / (1.0 + ez)
  else
    ez = Math.exp(z)
    ez / (1.0 + ez)
  end
end

# Composite score for a prediction set at a given probability threshold. rows is
# an array of {y:, ish:, p:}. fn_penalty (default 1.0) multiplies the FN terms
# so threshold selection can be tuned independently of the sample-weight lever that
# shapes the fit itself — useful for isolating which half of the pro-positive bias
# is driving a given set of failures. The row-weight schedule used for the
# "weighted_pct" readout still mirrors the evaluator's 3/1-tier "strong vs ish"
# confidence asymmetry so the two scripts report comparable numbers.
def composite_at(rows, threshold, fn_penalty: 1.0)
  comp = 0.0
  weighted_correct = 0.0
  weighted_total = 0.0
  strong_fn = ish_fn = strong_fp = ish_fp = 0
  rows.each do |r|
    pred = r[:p] >= threshold
    truth = r[:y] == 1.0
    # Report-side weights (unchanged by fn_penalty) — used only for the
    # human-readable "weighted accuracy" percentage printed in logs.
    row_w = if truth
              r[:ish] ? 3 : 9
            else
              r[:ish] ? 1 : 3
            end
    weighted_total += row_w
    if pred == truth
      weighted_correct += row_w
    elsif truth
      if r[:ish]
        ish_fn += 1
        comp += -1.0 * fn_penalty
      else
        strong_fn += 1
        comp += -3.0 * fn_penalty
      end
    else
      if r[:ish]
        ish_fp += 1
        comp += -1
      else
        strong_fp += 1
        comp += -3
      end
    end
  end
  {
    composite: comp,
    weighted_pct: 100.0 * weighted_correct / weighted_total,
    strong_fn: strong_fn,
    ish_fn: ish_fn,
    strong_fp: strong_fp,
    ish_fp: ish_fp,
  }
end

def best_threshold(rows, fn_penalty: 1.0)
  best = nil
  (5..95).step(1).each do |pct|
    t = pct / 100.0
    c = composite_at(rows, t, fn_penalty: fn_penalty)
    if best.nil? || c[:composite] > best[:stats][:composite]
      best = { threshold: t, stats: c }
    end
  end
  best
end

# --- Logistic regression backend -------------------------------------------

# Standardize columns 1..d-1 in-place (skip bias at column 0). Returns [means, stds].
def standardize!(rows)
  d = rows.first.size
  means = Array.new(d, 0.0)
  stds = Array.new(d, 1.0)
  n = rows.size.to_f

  (1...d).each do |j|
    s = 0.0
    rows.each { |r| s += r[j] }
    means[j] = s / n
    sq = 0.0
    rows.each { |r| sq += (r[j] - means[j])**2 }
    stds[j] = Math.sqrt(sq / n)
    stds[j] = 1.0 if stds[j] < 1e-9
  end

  rows.each do |r|
    (1...d).each { |j| r[j] = (r[j] - means[j]) / stds[j] }
  end
  [means, stds]
end

def fit_logreg(x_rows, y, sample_weights, lr:, l2:, epochs:, verbose: false)
  n = x_rows.size
  d = x_rows.first.size
  w = Array.new(d, 0.0)
  w_sum_total = sample_weights.sum.to_f

  prev_loss = Float::INFINITY
  epochs.times do |epoch|
    grad = Array.new(d, 0.0)
    loss = 0.0
    n.times do |i|
      x = x_rows[i]
      z = 0.0
      d.times { |j| z += w[j] * x[j] }
      p = sigmoid(z)
      err = p - y[i]
      sw = sample_weights[i]
      pc = [[p, 1e-12].max, 1 - 1e-12].min
      loss += -sw * (y[i] * Math.log(pc) + (1 - y[i]) * Math.log(1 - pc))
      d.times { |j| grad[j] += sw * err * x[j] }
    end
    (1...d).each { |j| grad[j] += l2 * w[j] }

    step = lr / w_sum_total
    d.times { |j| w[j] -= step * grad[j] }

    if verbose && (epoch % 100).zero?
      warn format("  epoch %4d loss=%.4f w0=%.3f", epoch, loss / w_sum_total, w[0])
    end

    delta = (prev_loss - loss).abs / [prev_loss.abs, 1.0].max
    break if delta < 1e-7 && epoch > 10
    prev_loss = loss
  end
  w
end

def predict_proba_logreg(raw_row, w, means, stds)
  z = 0.0
  raw_row.each_with_index do |v, j|
    x = j.zero? ? v : (v - means[j]) / stds[j]
    z += w[j] * x
  end
  sigmoid(z)
end

# --- Gradient-boosted tree backend -----------------------------------------
#
# Xgboost-style binary logistic: at each round, fit a regression tree to the
# (gradient / hessian) of log-loss wrt current margin, step margins by
# lr * leaf_value. Tree splits minimize the xgboost gain formula
#   gain = G_L^2/(H_L+λ) + G_R^2/(H_R+λ) - G^2/(H+λ)
# Leaf Newton step: w* = -sum(g) / (sum(h) + λ). Sample weights scale g and
# h, so downstream gain / leaf formulas stay identical to unweighted xgboost.
# Trees stored as flat arrays of nodes; node = {f,t,l,r} internal or {v} leaf.

def find_best_split(x_rows, g, h, feature_indices, rows, total_g, total_h, lambda_leaf:, min_child_hessian:)
  base_gain = total_g**2 / (total_h + lambda_leaf)
  best = nil
  best_gain = 0.0

  feature_indices.each do |f|
    sorted = rows.sort_by { |i| x_rows[i][f] }
    g_l = 0.0
    h_l = 0.0
    sz = sorted.size

    (0...sz - 1).each do |k|
      i = sorted[k]
      g_l += g[i]
      h_l += h[i]
      h_r = total_h - h_l
      next if h_l < min_child_hessian || h_r < min_child_hessian

      v_cur = x_rows[i][f]
      v_next = x_rows[sorted[k + 1]][f]
      next if v_cur == v_next

      g_r = total_g - g_l
      gain = g_l**2 / (h_l + lambda_leaf) + g_r**2 / (h_r + lambda_leaf) - base_gain
      if gain > best_gain
        best_gain = gain
        best = {
          feature: f,
          threshold: (v_cur + v_next) / 2.0,
          gain: gain,
        }
      end
    end
  end

  best
end

# Parallel-array tree: f (feature idx, -1 for leaves), t (threshold for internal
# nodes, leaf value for leaves — unioned into the same float slot), l / r (child
# indices, 0 for leaves). Building via append_* helpers keeps all four arrays the
# same length and lets the recursion return the just-appended node's index.
def append_leaf(tree, value)
  tree["f"] << -1
  tree["t"] << value
  tree["l"] << 0
  tree["r"] << 0
  tree["f"].size - 1
end

def append_internal(tree, f, t)
  tree["f"] << f
  tree["t"] << t
  tree["l"] << 0
  tree["r"] << 0
  tree["f"].size - 1
end

def build_tree_node(tree, x_rows, g, h, features, rows, depth, max_depth, lambda_leaf, min_child_hessian)
  total_g = 0.0
  total_h = 0.0
  rows.each do |i|
    total_g += g[i]
    total_h += h[i]
  end

  split = nil
  if depth < max_depth && rows.size >= 2 && total_h >= 2 * min_child_hessian
    split = find_best_split(
      x_rows, g, h, features, rows, total_g, total_h,
      lambda_leaf: lambda_leaf, min_child_hessian: min_child_hessian
    )
  end

  if split.nil?
    return append_leaf(tree, -total_g / (total_h + lambda_leaf))
  end

  left_rows = []
  right_rows = []
  f = split[:feature]
  t = split[:threshold]
  rows.each do |i|
    if x_rows[i][f] <= t
      left_rows << i
    else
      right_rows << i
    end
  end

  if left_rows.empty? || right_rows.empty?
    return append_leaf(tree, -total_g / (total_h + lambda_leaf))
  end

  node_idx = append_internal(tree, f, t)
  left_idx = build_tree_node(tree, x_rows, g, h, features, left_rows, depth + 1, max_depth, lambda_leaf, min_child_hessian)
  right_idx = build_tree_node(tree, x_rows, g, h, features, right_rows, depth + 1, max_depth, lambda_leaf, min_child_hessian)
  tree["l"][node_idx] = left_idx
  tree["r"][node_idx] = right_idx
  node_idx
end

def empty_tree
  { "f" => [], "t" => [], "l" => [], "r" => [] }
end

def predict_tree(tree, row)
  f = tree["f"]
  t = tree["t"]
  l = tree["l"]
  r = tree["r"]
  idx = 0
  loop do
    fi = f[idx]
    return t[idx] if fi < 0
    idx = row[fi] <= t[idx] ? l[idx] : r[idx]
  end
end

def fit_gbt(x_rows, y, sample_weights, trees:, depth:, lr:, lambda_leaf:, min_child_hessian:, colsample:, seed:, verbose: false)
  n = x_rows.size
  d = x_rows.first.size
  rng = Random.new(seed)

  # Initialize bias at weighted-mean logit (so first-round gradients aren't degenerate).
  sum_w = sample_weights.sum.to_f
  sum_wy = 0.0
  n.times { |i| sum_wy += sample_weights[i] * y[i] }
  p0 = sum_wy / sum_w
  p0 = [[p0, 1e-4].max, 1 - 1e-4].min
  bias = Math.log(p0 / (1 - p0))

  margins = Array.new(n, bias)
  ensemble = []

  # Bias=feature-0 is always 1.0; GBT can't meaningfully split on a constant.
  # Exclude it from splitting candidates.
  all_features = (1...d).to_a

  trees.times do |t|
    g = Array.new(n)
    h = Array.new(n)
    n.times do |i|
      p = sigmoid(margins[i])
      sw = sample_weights[i]
      g[i] = sw * (p - y[i])
      h[i] = sw * p * (1 - p)
    end

    if colsample < 1.0
      k = [(all_features.size * colsample).ceil, 1].max
      features = all_features.sample(k, random: rng)
    else
      features = all_features
    end

    tree = empty_tree
    build_tree_node(
      tree, x_rows, g, h, features, (0...n).to_a, 0, depth,
      lambda_leaf, min_child_hessian
    )

    n.times do |i|
      margins[i] += lr * predict_tree(tree, x_rows[i])
    end

    ensemble << tree

    if verbose && (t % 25).zero?
      loss = 0.0
      n.times do |i|
        p = sigmoid(margins[i])
        pc = [[p, 1e-12].max, 1 - 1e-12].min
        loss += -sample_weights[i] * (y[i] * Math.log(pc) + (1 - y[i]) * Math.log(1 - pc))
      end
      warn format("  tree %3d  loss=%.4f", t, loss / sum_w)
    end
  end

  [bias, ensemble]
end

def predict_proba_gbt(row, bias, trees, lr)
  score = bias
  trees.each { |t| score += lr * predict_tree(t, row) }
  sigmoid(score)
end

def gbt_feature_importance(trees, n_features)
  gains = Array.new(n_features, 0.0)
  trees.each do |tree|
    tree["f"].each do |fi|
      next if fi < 0
      gains[fi] += 1.0
    end
  end
  gains
end

# --- Shared fit / predict dispatch -----------------------------------------

# Fit one model on train_ids. Returns a lambda that scores a raw feature row
# and produces a probability, plus a symbol-keyed model hash for serialization.
def fit_model(model, features_list, labels, weights, train_ids, options)
  x_train = train_ids.map { |i| features_list[i].dup }
  y_train = train_ids.map { |i| labels[i] }
  w_train = train_ids.map { |i| weights[i] }

  case model
  when "logreg"
    means, stds = standardize!(x_train)
    w = fit_logreg(
      x_train, y_train, w_train,
      lr: options[:lr], l2: options[:l2], epochs: options[:epochs],
      verbose: options[:verbose]
    )
    predict = ->(row) { predict_proba_logreg(row, w, means, stds) }
    [predict, { model_type: "logreg", means: means, stds: stds, weights: w }]

  when "gbt"
    bias, trees = fit_gbt(
      x_train, y_train, w_train,
      trees: options[:trees], depth: options[:depth], lr: options[:gbt_lr],
      lambda_leaf: options[:lambda_leaf], min_child_hessian: options[:min_child_hessian],
      colsample: options[:colsample], seed: options[:seed], verbose: options[:verbose]
    )
    predict = ->(row) { predict_proba_gbt(row, bias, trees, options[:gbt_lr]) }
    [predict, { model_type: "gbt", bias: bias, lr: options[:gbt_lr], trees: trees }]

  else
    raise "unknown model: #{model}"
  end
end

# --- Load CSV, build training examples -------------------------------------

# Classifier must not see the stop-word short-circuit; the threshold-gate stage still handles those.
ENV["RELATED_LEARNED_MODE"] = "off"

path = File.join(repo, "curated", "related.csv")
raw_rows = CSV.parse(BuildIo.read(path, encoding: "UTF-8", hint: "train-relatedness-classifier related.csv"), headers: true)

# Drop semantically-promiscuous rows up front: the threshold-gate's short-circuit
# makes the predicate trivially-true for any pair where either side is
# promiscuous, so these rows can't teach the classifier anything useful (they'd
# just inject easy positives and confuse the negative half if labeled
# unrelated). Filter on both surface form and lemma — users write "running"
# but the short-circuit checks semantically_promiscuous?("running") only
# after the threshold gate computes lemma.
skipped_promiscuous = 0
rows = raw_rows.reject do |r|
  w1 = r["cue"]
  w2 = r["related"]
  next true if w1.nil? || w2.nil?
  drop = semantically_promiscuous?(w1) || semantically_promiscuous?(w2) || semantically_promiscuous?(lemma(w1)) || semantically_promiscuous?(lemma(w2))
  skipped_promiscuous += 1 if drop
  drop
end

features_list = []
labels = []
weights = []
ish_flags = []

# whatever rows ("either answer is fine") are skipped — the annotator
# specifically declined to make a confident call so we'd be over-claiming
# either way. This used to be a knob (RELATED_WHATEVER_AS_UNRELATED) that
# relabeled whatever to unrelated_ish for an extra ~200 soft negatives;
# the relabel never won the offline sweeps, so the knob was retired in
# May 2026.
skipped_whatever = 0

rows.each do |r|
  kind = r["oughta be related?"].to_s.strip
  if kind == "whatever"
    skipped_whatever += 1
    next
  end

  w1 = r["cue"]
  w2 = r["related"]
  # Normalization mode (must agree with the runtime predicate in
  # lib/rhymecrime/related.rb):
  #   * RELATED_SKIP_LEMMA=1 -> raw surfaces.
  #   * default                -> inflectional lemma(w).
  # Mismatch tanks TPR (see the bin/_lemma_ablation writeup).
  l1 = ENV["RELATED_SKIP_LEMMA"] == "1" ? w1 : lemma(w1)
  l2 = ENV["RELATED_SKIP_LEMMA"] == "1" ? w2 : lemma(w2)

  # PairSignals is now directional: the cue column is the cue, related
  # is the related candidate (see curated/related.csv's 2026-04 orientation
  # pass). Do NOT canonicalize lex-order here — that would feed lex order into
  # the directional sv_cue_to_related / usf_direct_cue_to_related /
  # unigram cue / related columns and turn them into noise that the GBT
  # can only fit overfit-style.
  signals = PairSignals.new(l1, l2)

  y = (kind == "related" || kind == "related_ish") ? 1.0 : 0.0
  ish = (kind == "related_ish" || kind == "unrelated_ish")
  # Base weight encodes the "strong vs ish" confidence asymmetry (3× for strong labels).
  # fn_weight (CLI default 1.0) multiplies only positive-class rows, turning the historical
  # 3:1 pro-positive pull on the fit into a knob; the symmetric default means the gradients
  # see a balanced problem regardless of class-count drift as more data arrives.
  base_w = ish ? 1.0 : 3.0
  sw = y == 1.0 ? base_w * options[:fn_weight] : base_w

  features_list << learned_feature_vector(signals)
  labels << y
  weights << sw
  ish_flags << ish
end

pos_weight_mass = weights.each_with_index.sum { |w, i| labels[i] == 1.0 ? w : 0.0 }
neg_weight_mass = weights.each_with_index.sum { |w, i| labels[i] == 0.0 ? w : 0.0 }
puts "model: #{options[:model]}"
puts "training examples: #{features_list.size}  (+#{skipped_whatever} whatever skipped, #{skipped_promiscuous} semantically-promiscuous pairs filtered at load)"
puts "positives: #{labels.count(1.0)}  negatives: #{labels.count(0.0)}"
puts format(
  "class asymmetry: fn_weight=%.2f (pos weight mass %.0f vs neg %.0f)  fn_penalty=%.2f",
  options[:fn_weight], pos_weight_mass, neg_weight_mass, options[:fn_penalty]
)
puts "feature count: #{features_list.first.size}  (#{LEARNED_FEATURE_NAMES.join(', ')})"
puts

# --- N-fold CV -------------------------------------------------------------

srand(options[:seed])
indices = (0...features_list.size).to_a.shuffle
folds = Array.new(options[:folds]) { [] }
indices.each_with_index { |idx, i| folds[i % options[:folds]] << idx }

cv_composites = []

puts "=== #{options[:folds]}-fold CV ==="
folds.each_with_index do |test_ids, fi|
  train_ids = folds.each_with_index.flat_map { |f, i| i == fi ? [] : f }

  predict, _model_data = fit_model(options[:model], features_list, labels, weights, train_ids, options)

  test_scored = test_ids.map do |i|
    { y: labels[i], ish: ish_flags[i], p: predict.call(features_list[i]) }
  end

  best = best_threshold(test_scored, fn_penalty: options[:fn_penalty])
  cv_composites << best
  s = best[:stats]
  puts format(
    "  fold %d  t=%.2f  composite=%.1f  weighted=%.1f%%  sfn=%d ifn=%d sfp=%d ifp=%d",
    fi, best[:threshold], s[:composite], s[:weighted_pct],
    s[:strong_fn], s[:ish_fn], s[:strong_fp], s[:ish_fp]
  )
end

pooled_composite = cv_composites.sum { |c| c[:stats][:composite] }
avg_thr = cv_composites.sum { |c| c[:threshold] } / cv_composites.size.to_f
avg_weighted = cv_composites.sum { |c| c[:stats][:weighted_pct] } / cv_composites.size.to_f
puts format("  CV pooled composite = %.1f  mean threshold = %.2f  mean weighted = %.1f%%",
  pooled_composite, avg_thr, avg_weighted)
puts

# --- Full-data fit for deployment ------------------------------------------

puts "=== full-data fit ==="
predict, model_data = fit_model(options[:model], features_list, labels, weights, (0...features_list.size).to_a, options)

scored = (0...features_list.size).map do |i|
  { y: labels[i], ish: ish_flags[i], p: predict.call(features_list[i]) }
end
swept = best_threshold(scored, fn_penalty: options[:fn_penalty])
# --threshold lets the operator pin the cutoff (e.g. to a previously deployed
# value) instead of taking whatever the in-sample sweep happens to land on.
# We still print the swept optimum alongside so it's obvious how much the pin
# is costing in-sample.
chosen_threshold = options[:threshold] || swept[:threshold]
chosen_stats = composite_at(scored, chosen_threshold, fn_penalty: options[:fn_penalty])
s = chosen_stats
if options[:threshold]
  ss = swept[:stats]
  puts format(
    "  in-sample (swept optimum)  t=%.2f  composite=%.1f  weighted=%.1f%%  sfn=%d ifn=%d sfp=%d ifp=%d",
    swept[:threshold], ss[:composite], ss[:weighted_pct],
    ss[:strong_fn], ss[:ish_fn], ss[:strong_fp], ss[:ish_fp]
  )
  puts format(
    "  in-sample (pinned --threshold)  t=%.2f  composite=%.1f  weighted=%.1f%%  sfn=%d ifn=%d sfp=%d ifp=%d",
    chosen_threshold, s[:composite], s[:weighted_pct],
    s[:strong_fn], s[:ish_fn], s[:strong_fp], s[:ish_fp]
  )
else
  puts format(
    "  in-sample  t=%.2f  composite=%.1f  weighted=%.1f%%  sfn=%d ifn=%d sfp=%d ifp=%d",
    chosen_threshold, s[:composite], s[:weighted_pct],
    s[:strong_fn], s[:ish_fn], s[:strong_fp], s[:ish_fp]
  )
end

puts
case options[:model]
when "logreg"
  puts "=== feature weights (raw units, for interpretation) ==="
  LEARNED_FEATURE_NAMES.each_with_index do |name, j|
    w = model_data[:weights][j]
    std = model_data[:stds][j]
    raw_w = j.zero? ? w : w / std
    puts format("  %-20s  std=%+8.4f  raw=%+8.4f", name, w, raw_w)
  end
when "gbt"
  puts "=== feature split counts (tree nodes using each feature) ==="
  counts = gbt_feature_importance(model_data[:trees], features_list.first.size)
  total_nodes = counts.sum
  LEARNED_FEATURE_NAMES.each_with_index do |name, j|
    next if counts[j] == 0
    pct = total_nodes.zero? ? 0.0 : (100.0 * counts[j] / total_nodes)
    puts format("  %-20s  splits=%4d  (%.1f%%)", name, counts[j].to_i, pct)
  end
  puts format("  total internal splits: %d across %d trees", total_nodes.to_i, model_data[:trees].size)
end
puts

# --- Write classifier ------------------------------------------------------

common = {
  "feature_names" => LEARNED_FEATURE_NAMES,
  "model_type" => model_data[:model_type],
  "threshold" => chosen_threshold,
  "training" => {
    "model" => options[:model],
    "rows" => features_list.size,
    "positives" => labels.count(1.0),
    "negatives" => labels.count(0.0),
    "fn_weight" => options[:fn_weight],
    "fn_penalty" => options[:fn_penalty],
    "seed" => options[:seed],
    "threshold_pinned" => !options[:threshold].nil?,
    "swept_threshold" => swept[:threshold],
    "cv_folds" => options[:folds],
    "cv_pooled_composite" => pooled_composite,
    "cv_mean_threshold" => avg_thr,
    "in_sample_composite" => s[:composite],
    "in_sample_weighted_pct" => s[:weighted_pct],
  },
}

case options[:model]
when "logreg"
  common["means"] = model_data[:means]
  common["stds"] = model_data[:stds]
  common["weights"] = model_data[:weights]
  common["training"].merge!("l2" => options[:l2], "lr" => options[:lr], "epochs" => options[:epochs])
when "gbt"
  common["bias"] = model_data[:bias]
  common["lr"] = model_data[:lr]
  common["tree_format"] = "parallel_v1"
  common["trees"] = model_data[:trees]
  common["training"].merge!(
    "trees" => options[:trees],
    "depth" => options[:depth],
    "gbt_lr" => options[:gbt_lr],
    "lambda_leaf" => options[:lambda_leaf],
    "min_child_hessian" => options[:min_child_hessian],
    "colsample" => options[:colsample],
  )
end

if options[:dry_run]
  puts "(--dry-run: not writing output file)"
else
  out_path = generated_stamp_path(RELATEDNESS_CLASSIFIER_FILENAME)
  BuildIo.write(out_path, JSON.generate(common), encoding: "UTF-8", hint: "train-relatedness-classifier")
  size_kb = File.size(out_path) / 1024.0
  puts format("wrote %s (%.1f KB)", out_path, size_kb)
end
