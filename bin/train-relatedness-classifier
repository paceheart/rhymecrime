#!/usr/bin/env ruby
# frozen_string_literal: true
#
# Train the phase-2 learned combiner for thematic relatedness.
#
# Input:  spec/related.csv  (gold-labeled pairs: related / related_ish / unrelated / unrelated_ish / whatever)
# Output: generated/relatedness_classifier.json
#           { feature_names: [...], means: [...], stds: [...], weights: [...], threshold: 0.x, ... }
#
# Learns a logistic regression over +learned_feature_vector+ (20 symmetrized features
# pulled from +PairSignals+), optimizing weighted log-loss whose sample weights mirror
# the evaluation objective in +spec/related_weighted_accuracy.rb+: strong-related rows
# count 9, ish-related 3, strong-unrelated 3, ish-unrelated 1. After fitting, sweeps
# the decision threshold over [0.05, 0.95] and picks the probability cutoff maximizing
# the composite score (same 3:1 FN:FP penalty ratio used at evaluation time).
#
# Reports 5-fold CV composite/weighted-accuracy for an honest generalization estimate,
# then fits once on the full labeled set for deployment. The deployed model is the
# one written to disk; CV numbers are for guidance.
#
#   ruby bin/train-relatedness-classifier
#   ruby bin/train-relatedness-classifier --folds 10 --epochs 1000 --l2 0.02
#   ruby bin/train-relatedness-classifier --dry-run          # don't write output file
#
# After a successful train, run +spec/related_weighted_accuracy.rb+ to see the lift
# (default is +RELATED_LEARNED_MODE=additive+; try +=replace+ for a pure learned combiner).

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "csv"
require "json"
require "optparse"

options = {
  folds: 5,
  epochs: 600,
  lr: 0.3,
  l2: 0.02,
  seed: 42,
  dry_run: false,
  verbose: false,
}

OptionParser.new do |opt|
  opt.on("--folds N", Integer) { |v| options[:folds] = v }
  opt.on("--epochs N", Integer) { |v| options[:epochs] = v }
  opt.on("--lr F", Float) { |v| options[:lr] = v }
  opt.on("--l2 F", Float) { |v| options[:l2] = v }
  opt.on("--seed N", Integer) { |v| options[:seed] = v }
  opt.on("--dry-run") { options[:dry_run] = true }
  opt.on("--verbose") { options[:verbose] = true }
end.parse!

ENV.delete("RHYMECRIME_DATA_SOURCE")

repo = File.expand_path("..", __dir__)
Dir.chdir(repo)

require "rhymecrime/crime"

def sigmoid(z)
  if z >= 0
    ez = Math.exp(-z)
    1.0 / (1.0 + ez)
  else
    ez = Math.exp(z)
    ez / (1.0 + ez)
  end
end

# Standardize columns 1..d-1 in-place (skip bias at column 0). Returns [means, stds].
def standardize!(rows)
  d = rows.first.size
  means = Array.new(d, 0.0)
  stds = Array.new(d, 1.0)
  n = rows.size.to_f

  (1...d).each do |j|
    s = 0.0
    rows.each { |r| s += r[j] }
    means[j] = s / n
    sq = 0.0
    rows.each { |r| sq += (r[j] - means[j])**2 }
    stds[j] = Math.sqrt(sq / n)
    stds[j] = 1.0 if stds[j] < 1e-9
  end

  rows.each do |r|
    (1...d).each { |j| r[j] = (r[j] - means[j]) / stds[j] }
  end
  [means, stds]
end

# Apply an already-fit standardization to a fresh row.
def apply_standardize(row, means, stds)
  d = row.size
  out = row.dup
  (1...d).each { |j| out[j] = (row[j] - means[j]) / stds[j] }
  out
end

# Batch gradient descent with L2 regularization (bias unregularized). Sample-weighted
# log-loss. Returns weight vector.
def fit_logreg(x_rows, y, sample_weights, lr:, l2:, epochs:, verbose: false)
  n = x_rows.size
  d = x_rows.first.size
  w = Array.new(d, 0.0)
  w_sum_total = sample_weights.sum.to_f

  prev_loss = Float::INFINITY
  epochs.times do |epoch|
    grad = Array.new(d, 0.0)
    loss = 0.0
    n.times do |i|
      x = x_rows[i]
      z = 0.0
      d.times { |j| z += w[j] * x[j] }
      p = sigmoid(z)
      err = p - y[i]
      sw = sample_weights[i]
      pc = [[p, 1e-12].max, 1 - 1e-12].min
      loss += -sw * (y[i] * Math.log(pc) + (1 - y[i]) * Math.log(1 - pc))
      d.times { |j| grad[j] += sw * err * x[j] }
    end
    (1...d).each { |j| grad[j] += l2 * w[j] }

    step = lr / w_sum_total
    d.times { |j| w[j] -= step * grad[j] }

    if verbose && (epoch % 100).zero?
      warn format("  epoch %4d loss=%.4f w0=%.3f", epoch, loss / w_sum_total, w[0])
    end

    delta = (prev_loss - loss).abs / [prev_loss.abs, 1.0].max
    break if delta < 1e-7 && epoch > 10
    prev_loss = loss
  end
  w
end

# Predict probability given raw feature row and standardization.
def predict_proba(raw_row, w, means, stds)
  z = 0.0
  raw_row.each_with_index do |v, j|
    x = j.zero? ? v : (v - means[j]) / stds[j]
    z += w[j] * x
  end
  sigmoid(z)
end

# Composite score for a prediction set at a given probability threshold. +rows+ is
# an array of {y:, ish:, p:}.
def composite_at(rows, threshold)
  comp = 0
  weighted_correct = 0
  weighted_total = 0
  strong_fn = ish_fn = strong_fp = ish_fp = 0
  rows.each do |r|
    pred = r[:p] >= threshold
    truth = r[:y] == 1.0
    row_w = if truth
              r[:ish] ? 3 : 9
            else
              r[:ish] ? 1 : 3
            end
    weighted_total += row_w
    if pred == truth
      weighted_correct += row_w
    elsif truth
      if r[:ish]
        ish_fn += 1
        comp += -3
      else
        strong_fn += 1
        comp += -9
      end
    else
      if r[:ish]
        ish_fp += 1
        comp += -1
      else
        strong_fp += 1
        comp += -3
      end
    end
  end
  {
    composite: comp,
    weighted_pct: 100.0 * weighted_correct / weighted_total,
    strong_fn: strong_fn,
    ish_fn: ish_fn,
    strong_fp: strong_fp,
    ish_fp: ish_fp,
  }
end

def best_threshold(rows)
  best = nil
  (5..95).step(1).each do |pct|
    t = pct / 100.0
    c = composite_at(rows, t)
    if best.nil? || c[:composite] > best[:stats][:composite]
      best = { threshold: t, stats: c }
    end
  end
  best
end

# --- Load CSV, build training examples ---

# Classifier must not see the stop-word short-circuit; phase 3 still handles those.
ENV["RELATED_LEARNED_MODE"] = "off"

path = File.join(repo, "spec", "related.csv")
raw_rows = CSV.parse(File.read(path, encoding: "UTF-8"), headers: true)

features_list = []
labels = []
weights = []
ish_flags = []

skipped_stopword = 0
skipped_whatever = 0

raw_rows.each do |r|
  kind = r["oughta be related?"].to_s.strip
  if kind == "whatever"
    skipped_whatever += 1
    next
  end

  w1 = r["word1"]
  w2 = r["word2"]
  if stop_word?(w1) || stop_word?(w2)
    skipped_stopword += 1
    next
  end
  l1 = lemma(w1)
  l2 = lemma(w2)
  if stop_word?(l1) || stop_word?(l2)
    skipped_stopword += 1
    next
  end

  a, b = l1 <= l2 ? [l1, l2] : [l2, l1]
  signals = PairSignals.new(a, b)

  y = (kind == "related" || kind == "related_ish") ? 1.0 : 0.0
  ish = (kind == "related_ish" || kind == "unrelated_ish")
  sw = if y == 1.0
         ish ? 3.0 : 9.0
       else
         ish ? 1.0 : 3.0
       end

  features_list << learned_feature_vector(signals)
  labels << y
  weights << sw
  ish_flags << ish
end

puts "training examples: #{features_list.size}  (+#{skipped_whatever} whatever, #{skipped_stopword} stop-word pairs skipped)"
puts "positives: #{labels.count(1.0)}  negatives: #{labels.count(0.0)}"
puts "feature count: #{features_list.first.size}  (#{LEARNED_FEATURE_NAMES.join(', ')})"
puts

# --- 5-fold CV ---

srand(options[:seed])
indices = (0...features_list.size).to_a.shuffle
folds = Array.new(options[:folds]) { [] }
indices.each_with_index { |idx, i| folds[i % options[:folds]] << idx }

cv_rows_pooled = []
cv_composites = []

puts "=== #{options[:folds]}-fold CV ==="
folds.each_with_index do |test_ids, fi|
  train_ids = folds.each_with_index.flat_map { |f, i| i == fi ? [] : f }

  x_train = train_ids.map { |i| features_list[i].dup }
  y_train = train_ids.map { |i| labels[i] }
  w_train = train_ids.map { |i| weights[i] }

  means, stds = standardize!(x_train)
  w_model = fit_logreg(
    x_train, y_train, w_train,
    lr: options[:lr], l2: options[:l2], epochs: options[:epochs], verbose: options[:verbose]
  )

  test_scored = test_ids.map do |i|
    p = predict_proba(features_list[i], w_model, means, stds)
    { y: labels[i], ish: ish_flags[i], p: p }
  end

  best = best_threshold(test_scored)
  cv_rows_pooled.concat(test_scored)
  cv_composites << best

  s = best[:stats]
  puts format(
    "  fold %d  t=%.2f  composite=%d  weighted=%.1f%%  sfn=%d ifn=%d sfp=%d ifp=%d",
    fi, best[:threshold], s[:composite], s[:weighted_pct],
    s[:strong_fn], s[:ish_fn], s[:strong_fp], s[:ish_fp]
  )
end

avg_comp = cv_composites.sum { |c| c[:stats][:composite] } / cv_composites.size.to_f
avg_thr = cv_composites.sum { |c| c[:threshold] } / cv_composites.size.to_f
puts format("  CV mean composite = %.1f  mean threshold = %.2f", avg_comp, avg_thr)
puts

# --- Full-data fit for deployment ---

puts "=== full-data fit ==="
x_full = features_list.map(&:dup)
y_full = labels
w_full = weights
means, stds = standardize!(x_full)

w_model = fit_logreg(
  x_full, y_full, w_full,
  lr: options[:lr], l2: options[:l2], epochs: options[:epochs], verbose: options[:verbose]
)

scored = (0...features_list.size).map do |i|
  p = predict_proba(features_list[i], w_model, means, stds)
  { y: labels[i], ish: ish_flags[i], p: p }
end
best = best_threshold(scored)
s = best[:stats]
puts format(
  "  in-sample  t=%.2f  composite=%d  weighted=%.1f%%  sfn=%d ifn=%d sfp=%d ifp=%d",
  best[:threshold], s[:composite], s[:weighted_pct],
  s[:strong_fn], s[:ish_fn], s[:strong_fp], s[:ish_fp]
)

# Feature-weight report in raw units (un-standardize for interpretability).
puts
puts "=== feature weights (raw units, for interpretation) ==="
LEARNED_FEATURE_NAMES.each_with_index do |name, j|
  raw_w = j.zero? ? w_model[j] : w_model[j] / stds[j]
  puts format("  %-20s  std=%+8.4f  raw=%+8.4f", name, w_model[j], raw_w)
end
puts

# --- Write classifier ---

out = {
  "feature_names" => LEARNED_FEATURE_NAMES,
  "means" => means,
  "stds" => stds,
  "weights" => w_model,
  "threshold" => best[:threshold],
  "training" => {
    "rows" => features_list.size,
    "positives" => labels.count(1.0),
    "negatives" => labels.count(0.0),
    "l2" => options[:l2],
    "lr" => options[:lr],
    "epochs" => options[:epochs],
    "seed" => options[:seed],
    "cv_folds" => options[:folds],
    "cv_mean_composite" => avg_comp,
    "cv_mean_threshold" => avg_thr,
    "in_sample_composite" => s[:composite],
    "in_sample_weighted_pct" => s[:weighted_pct],
  },
}

if options[:dry_run]
  puts "(--dry-run: not writing output file)"
else
  out_path = generated_dict_path(RELATEDNESS_CLASSIFIER_FILENAME)
  File.write(out_path, JSON.pretty_generate(out), encoding: "UTF-8")
  puts "wrote #{out_path}"
end
