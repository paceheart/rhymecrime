#!/usr/bin/env ruby
# frozen_string_literal: true

# Pre-compute thematically related headword lists per distinct lemma.
#
# Cue set (one row per): every +word_common_preferred_headword?+ lemma,
# including rhymeless ones like +music+ / +concerto+ / +algebra+ — runtime
# (and +spec/related_weighted_accuracy.rb+) may legitimately ask
# +thematically_related?+ about any common headword, so we need a row for any
# common headword.
#
# Relateds list (per row): +find_all_thematically_related_words_by_scan(lem,
# include_rhymeless=false, common_only=true)+ — narrower, only rhymable
# common headwords, because rhymeless lemmas have no UI path to show up as a
# related rhyme suggestion. This asymmetry is intentional (see the
# +lemmas = rep.keys.select+ block below for the cue-side filter).
# Computation uses only local generated/ files (no RHYMECRIME_DATA_SOURCE=dynamodb).
# Writes directly into the local SQLite store (generated/rhymecrime_local.sqlite3) — the same file
# +Rhymecrime::LocalStore+ reads at runtime and +bin/upload-to-dynamodb+ streams to prod DDB.
#
#   ruby bin/precompute-relatedness
#
# Options:
#   --output=PATH          Override SQLite path (default: generated/rhymecrime_local.sqlite3)
#   --dry-run              Compute only; print progress, do not write a file
#   --max-cues=N           Only process first N lemmas (smoke test)
#   --start-after=WORD     Resume-after-crash: skip lemmas up through this one in
#                          the current processing order (freq-desc, alpha within band).
#                          Will do the wrong thing if the word frequencies changed
#                          between runs — in that case, re-run with --incremental
#   --threads=N            Parallel workers (fork-based). Default: half of +Etc.nprocessors+.
#   --incremental          Keep existing rows in the target DB and only process cues
#                          not already present. Use after widening the cue filter so
#                          you don't redo cues the stored rows already cover.
#
# Ordering: cues are processed frequency-descending, alphabetical within band.
# This front-loads the high-value common cues so a Ctrl-C partway through still
# leaves the hub lemmas persisted; the long tail of lower-freq cues runs last.
#
# Threading notes: the compute is pure-Ruby CPU-bound, so we fork worker processes
# rather than native threads (MRI's GVL prevents parallel Ruby execution). All
# heavy data (Numberbatch ~169 MB, ConceptNet, MPNet ~923 MB, WordNet, classifier)
# loads in the parent before fork, so workers share those pages via copy-on-write.
# Peak RSS per worker climbs to ~2.5 GB as its +$thematically_related_memo+ /
# +$gloss_negative_pair_cache+ dirty pages and break CoW sharing; the default
# therefore takes the min of two caps:
#   * CPU cap:    +Etc.nprocessors / 2+          — keep the box responsive
#   * memory cap: +(RAM - OS_RESERVE) / PER_WORKER_RSS+
# so a 16 GB box doesn't try to run 5 workers just because it has 10 cores and
# end up swapping. Override either cap with +--threads=N+, or tune the
# +RHYMECRIME_PRECOMPUTE_PER_WORKER_GB+ / +RHYMECRIME_PRECOMPUTE_OS_RESERVE_GB+
# env vars if the observed RSS drifts.
#
# Output: each worker writes to its own shard SQLite file (+.shardN.tmp+ next to
# the target DB); the parent attaches + +INSERT OR REPLACE+ merges on success.
# Per-shard DBs avoid write contention that would otherwise serialize workers on
# the main file's WAL lock.
#
# OOV Numberbatch: headwords whose dictionary lemma has no row in generated/numberbatch_vectors.msgpack
# skip the expensive full relatedness scan (see +dictionary_lemma_has_numberbatch_vector?+ in related.rb).
# Set RHYMECRIME_WARN_OOV_NUMBERBATCH=1 to print a line to stderr for each such headword.

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

ENV.delete("RHYMECRIME_DATA_SOURCE")

require "etc"
require "optparse"
require_relative "../lib/rhymecrime/dict/utils_rhyme"
require_relative "../lib/rhymecrime/frontend"
require_relative "../lib/rhymecrime/dict/rime"
require_relative "../lib/rhymecrime/local_store"
# Full-compute pipeline (Numberbatch, ConceptNet, WordNet, USF, MPNet,
# classifier): not required at Lambda runtime, explicitly pulled in here
# because this script's whole job is to produce the cache the runtime reads.
require_relative "../lib/rhymecrime/relatedness/signals"
require_relative "../lib/rhymecrime/relatedness/score"
require_relative "../lib/rhymecrime/relatedness/scan"

output_path = Rhymecrime::LocalStore.database_path
dry_run = false
max_cues = nil
start_after = nil
incremental = false
# Detect installed physical RAM in bytes (macOS / Linux). Falls back to +nil+
# on other platforms or when the probe fails, in which case we skip the
# memory-based cap and rely on the CPU cap alone. Called once during startup;
# the +sysctl+ / +/proc/meminfo+ cost is negligible.
def detect_physical_memory_bytes
  case RbConfig::CONFIG["host_os"]
  when /darwin/
    out = `sysctl -n hw.memsize 2>/dev/null`.strip
    out.empty? ? nil : out.to_i
  when /linux/
    line = File.foreach("/proc/meminfo", encoding: "UTF-8").find { |l| l.start_with?("MemTotal:") }
    line ? line.split[1].to_i * 1024 : nil
  end
rescue StandardError
  nil
end

# Per-worker peak RSS assumption (GB). Measured around 2.5 GB on the +pirate+
# precompute profile; rounded up a little for headroom (GC thrash bloats the
# heap beyond the steady-state working set before major collections clean up).
per_worker_gb = (ENV["RHYMECRIME_PRECOMPUTE_PER_WORKER_GB"] || "3").to_f
# Leave this much RAM free for the OS + editors + browser + kernel caches.
# Going below this tips the OS into swap, which tanks throughput far worse then
# dropping a worker.
os_reserve_gb = (ENV["RHYMECRIME_PRECOMPUTE_OS_RESERVE_GB"] || "4").to_f

cpu_cap = [Etc.nprocessors / 2, 1].max

mem_bytes = detect_physical_memory_bytes
mem_cap =
  if mem_bytes && per_worker_gb.positive?
    usable = [mem_bytes - (os_reserve_gb * 1024**3).to_i, 0].max
    [(usable / (per_worker_gb * 1024**3)).to_i, 1].max
  end

default_threads =
  if mem_cap
    [cpu_cap, mem_cap].min
  else
    cpu_cap
  end
threads = default_threads
# Declared at outer scope so the +--threads=N+ block can assign to it without
# shadowing as a block-local; we check it below to decide whether to explain
# the derived default.
threads_user_supplied = false

OptionParser.new do |o|
  o.on("--output=PATH", "SQLite output path") { |p| output_path = File.expand_path(p) }
  o.on("--dry-run", "Compute only; do not write") { dry_run = true }
  o.on("--max-cues=N", Integer) { |n| max_cues = n }
  o.on("--start-after=WORD") { |w| start_after = w }
  o.on("--threads=N", Integer, "Parallel fork workers (default: #{default_threads})") do |n|
    threads = [n, 1].max
    threads_user_supplied = true
  end
  o.on("--incremental", "Keep existing rows; skip cues already present in +output-path+. " \
                       "Use when widening the cue filter to avoid redoing the cues already done.") do
    incremental = true
  end
end.parse!

word_path = generated_dict_path(WORD_DICT_FILENAME)
unless File.exist?(word_path)
  warn "Missing #{word_path}"
  exit 1
end

# lemma -> one representative common headword (prefer self-lemma)
rep = {}
File.foreach(word_path, encoding: "UTF-8") do |line|
  next unless useful_line?(line)

  parts = line.chomp.split(",", 4)
  word = parts[0].desanitize
  freq = parts[1].to_i
  next if freq <= RARE_FREQ_MAX

  lemma_raw = parts[3]
  lem = (lemma_raw && !lemma_raw.strip.empty?) ? lemma_raw.strip.desanitize : word

  rep[lem] ||= word
  rep[lem] = lem if word == lem
end

wd = word_dict
rd = rdict
before_n = rep.size
# Asymmetric cue / relateds filtering: see +cue_word?+ vs
# +relatedness_target_word?+ in +lib/rhymecrime/dict/rime.rb+. Cues include
# rhymeless lemmas (+music+, +concerto+, +algebra+, +quarterback+) so any
# question +thematically_related?+ might be asked at runtime has a row; the
# rhyme-partner check lives in +relatedness_target_word?+ and only governs the
# _relateds_ list inside each row (see +process_cue+ below, which uses
# +find_all_thematically_related_words_by_scan(..., false, true)+ — i.e.
# +include_rhymeless=false, common_only=true+). Pre-asymmetry, ~70 CSV pairs
# with e.g. +music+/+drumstick+ missed the store entirely and fell through to
# the slow compute path every eval run.
lemmas = rep.keys.select do |lem|
  next false unless wd.key?(lem)

  cue_word?(lem, wd)
end
# Process high-frequency cues first so a mid-run Ctrl-C leaves the hub lemmas
# persisted. +frequency+ is heavily quantized in +word_dict+ (mostly 99 vs
# ~10), so this degenerates into a two-bucket priority queue with a
# deterministic alpha sort inside each band (handy for diffing progress logs
# between runs).
lemmas.sort_by! { |l| [-wd[l][0].to_i, l] }
# Stop words are related to every other word (see +thematically_related?+), so their
# precompute entry would be the full candidate list — ~20k headwords per stop word.
# The runtime in +RelatedWords.find_all_thematically_related_words+ short-circuits
# stop-word lookups to +words_we_care_about+ directly, so no row is needed. Peel
# them off before +--start-after+ / +--max-cues+ apply so a +--max-cues=5+ smoke
# test doesn't burn its entire budget on +a+/+about+/+above+ (all freq-99 stop
# words that sort ahead of the real work).
stopword_lemmas, lemmas = lemmas.partition { |l| stop_word?(l) }
puts "Skipping #{stopword_lemmas.size} stop-word lemmas (runtime short-circuits to words_we_care_about): #{stopword_lemmas.inspect}" if stopword_lemmas.any?

if start_after
  # Resume-after-crash: drop everything up through +start_after+ in the current
  # sort order (freq-desc, alpha). Pre-reorder this compared lexicographically,
  # which no longer matches the processing order.
  idx = lemmas.index(start_after)
  lemmas = idx ? lemmas[(idx + 1)..] : []
end
lemmas = lemmas.first(max_cues) if max_cues

# +--incremental+: keep the existing +output_path+ DB and only process cues
# not already present. Used to grow the precompute table after widening the
# cue filter (or after adding new rare headwords to the dict) without redoing
# hours of work the stored rows already cover. Everything downstream (shard
# writes, merge via +INSERT OR REPLACE+) already tolerates this — we just
# filter the worklist up front.
if incremental && !dry_run && File.exist?(output_path)
  require "sqlite3"
  existing = Set.new
  db = SQLite3::Database.new(output_path, readonly: true)
  begin
    db.execute("SELECT pk FROM related") do |(pk)|
      lem = pk.to_s.delete_prefix("related#")
      existing << lem unless lem.empty?
    end
  ensure
    db.close
  end
  before = lemmas.size
  lemmas = lemmas.reject { |l| existing.include?(l) }
  puts "Incremental: skipping #{before - lemmas.size} cues already in #{output_path} (#{existing.size} total existing rows); processing #{lemmas.size} new."
end

n = lemmas.size
threads = [threads, n].min if n.positive?
threads = 1 if threads < 1

puts "Precompute cues: #{n} preferred common lemmas with rhymes (#{before_n} distinct common lemmas in word_dict before filter)"
unless threads_user_supplied
  # Show how the default fell out so it's obvious whether CPU or RAM is the
  # binding constraint; users with more RAM can then override with +--threads+.
  # Reports +default_threads+ rather than +threads+ because small +--max-cues+
  # runs clamp +threads+ down to +n+ and would otherwise hide the real default.
  ram_gb = mem_bytes ? (mem_bytes.to_f / 1024**3).round(1) : nil
  ram_note = ram_gb ? "RAM cap=#{mem_cap} (#{ram_gb} GB, per-worker #{per_worker_gb} GB, OS reserve #{os_reserve_gb} GB)" : "RAM cap unavailable"
  puts "Default threads=#{default_threads}: min(CPU cap=#{cpu_cap} (nproc/2), #{ram_note}). Override with --threads=N."
end
puts "Scanning #{n} lemmas → #{dry_run ? '(dry-run, no file)' : output_path} with #{threads} worker#{threads == 1 ? '' : 's'} (SQLite row only when ≥1 related word)"

RelatedWords.instance_variable_set(:@related_word_cache, {})

# Wall-clock timer covers warm-up + scan + merge; reported at the end alongside
# the worker count so run-to-run comparisons (e.g. --threads=4 vs --threads=8)
# are easy to spot-check.
run_started_at = Process.clock_gettime(Process::CLOCK_MONOTONIC)

# Per-cue +find_all_thematically_related_words+ scans every candidate headword (~20k) and
# calls +thematically_related?+ on each pair, populating +$thematically_related_memo+ and
# +$gloss_negative_pair_cache+ with one entry per pair. Across ~20k cues that's O(N²)
# entries — hundreds of millions — which sends Ruby's GC into progressively worse
# thrashing (ETA climbs then swings around erratically). Within a single scan each
# candidate is distinct so the pair memo gives no intra-scan benefit; across scans it
# only ever saves the symmetric (b, a) recomputation when both endpoints are cues,
# a ~2x win nowhere near worth the memory cost. Reset them after each cue. Same for
# +@related_word_cache+, which never sees a repeat lookup in this loop.
reset_per_cue_caches = lambda do
  $thematically_related_memo = nil
  $gloss_negative_pair_cache = Set.new
  RelatedWords.instance_variable_set(:@related_word_cache, {})
end

# Process a single cue: full-scan path captures the +relatedness_score+ computed
# for each cue / candidate pair alongside the candidate headword. Returns a
# +[words, scores]+ pair (parallel arrays sorted descending by score) or +nil+
# when the cue has no related words.
process_cue = lambda do |lem|
  reset_per_cue_caches.call
  word_score_pairs = RelatedWords.find_all_thematically_related_words_by_scan(lem, false, true)
  return nil if word_score_pairs.empty?

  # Clamp to 0..100 (the stop-word shortcut emits 100; rule-based scoring
  # can emit slightly over 100 via the cooccurrence combiner; threshold
  # floor is 50). Sort descending by score so the related-list UI gets the
  # strongest hits first and +max_candidates+ truncation keeps them.
  sorted = word_score_pairs
    .map { |w, s| [w, s.clamp(0, 100)] }
    .sort_by { |(_w, s)| -s }

  [sorted.map(&:first), sorted.map(&:last)]
end

# Run the scan for +shard+ (the slice of +lemmas+ assigned to this worker),
# upserting one SQLite row per non-empty cue through +writer+ (or nil for
# dry-run). +tag+ is a short identifier printed with each progress line.
run_shard = lambda do |shard, writer, tag|
  t0 = Process.clock_gettime(Process::CLOCK_MONOTONIC)
  total = shard.size
  shard.each_with_index do |lem, i|
    result = process_cue.call(lem)
    if (i % 50).zero? || i == total - 1
      done = i + 1
      elapsed = Process.clock_gettime(Process::CLOCK_MONOTONIC) - t0
      remaining = total - done
      eta_suffix =
        if remaining.positive? && done.positive? && elapsed.positive?
          eta_sec = [(remaining.to_f * elapsed / done).round, 0].max
          eh = eta_sec / 3600
          em = (eta_sec % 3600) / 60
          "~#{eh}h #{em}m remaining"
        else
          ""
        end
      paren = eta_suffix.empty? ? "" : " (#{eta_suffix})"
      count = result ? result[0].size : 0
      puts "  [#{tag} #{i}/#{total}] #{lem}: #{count} related#{paren}"
    end
    next unless result && writer

    words, scores = result
    writer.upsert_related(lem, words, scores)
  end
end

# Single-process path: keep the simple in-memory flow so stack traces /
# interactive debugging work normally. Writes directly to the final SQLite
# path in a single transaction.
if threads <= 1 || n.zero?
  if dry_run
    run_shard.call(lemmas, nil, "0")
  else
    # Non-incremental: wipe the old DB so rows dropped by the current cue
    # filter don't survive. Incremental: keep the existing DB; the single-
    # writer transaction below will +INSERT OR REPLACE+ just the new rows.
    File.delete(output_path) if !incremental && File.exist?(output_path)
    Rhymecrime::LocalStore.open_for_write(output_path) do |writer|
      run_shard.call(lemmas, writer, "0")
    end
  end
else
  # Fork-based parallelism. Ruby's GVL serializes pure-Ruby execution in
  # threads, so native threads give us no speedup on this CPU-bound workload.
  # Forking after all data is loaded lets workers share the big read-only
  # tables (Numberbatch, ConceptNet, MPNet, classifier) via copy-on-write.
  #
  # Eager-load every lazy global here so workers inherit the populated tables
  # instead of re-reading the files N times (+30s per worker, +1GB RSS per
  # worker). GC will still dirty some pages over time — COW isn't perfect —
  # but peak RSS stays closer to 1x than Nx.
  puts "Warming up compute caches in parent before fork..."
  numberbatch
  conceptnet_edges
  conceptnet_adjacency
  usf_associations
  model_sense_vectors_table
  relatedness_classifier
  words_we_care_about(false, true)
  puts "Warm-up complete."

  # Round-robin shard distribution so alphabetical clustering of expensive
  # cues (long words, hub lemmas) doesn't starve the last worker.
  shards = Array.new(threads) { [] }
  lemmas.each_with_index { |lem, i| shards[i % threads] << lem }

  # Each worker writes to its own SQLite file; parent ATTACHes + merges on
  # success. +.shardN.tmp+ sits next to the final output so it lives on the
  # same filesystem (ATTACH across filesystems still works but copy is slower)
  # and is easy to spot + clean up on crash.
  shard_paths = dry_run ? Array.new(threads) { nil } : Array.new(threads) { |i| "#{output_path}.shard#{i}.tmp" }

  # Fresh shard files every run: stale rows from a crashed previous shard
  # would otherwise survive the merge.
  shard_paths.each { |p| File.delete(p) if p && File.exist?(p) }

  # Flush so parent's stdout buffer isn't duplicated into every child.
  $stdout.flush
  $stderr.flush

  pids = shards.each_with_index.map do |shard, idx|
    fork do
      # Worker: fresh memos (inherited from parent are fine but will diverge
      # across workers anyway). Exit status encodes success/failure.
      shard_path = shard_paths[idx]
      if shard_path
        Rhymecrime::LocalStore.open_for_write(shard_path) do |writer|
          run_shard.call(shard, writer, "w#{idx}")
        end
      else
        run_shard.call(shard, nil, "w#{idx}")
      end
    end
  end

  # Wait on every child; surface any nonzero exit.
  failed = []
  pids.each_with_index do |pid, idx|
    _, status = Process.wait2(pid)
    failed << [idx, status] unless status.success?
  end

  unless failed.empty?
    # Clean up partial shard files on failure so the next run doesn't merge
    # half-written output.
    shard_paths.each { |p| File.delete(p) if p && File.exist?(p) }
    failed.each { |idx, st| warn "worker w#{idx} failed: #{st.inspect}" }
    exit 1
  end

  unless dry_run
    # Non-incremental: wipe the destination so rows dropped by the current
    # cue filter don't survive. Incremental: keep it; +merge_shard+ does
    # +INSERT OR REPLACE+ so the new shards overlay cleanly on the existing
    # rows without touching cues not in this run.
    File.delete(output_path) if !incremental && File.exist?(output_path)
    puts "Merging #{shard_paths.size} shard#{shard_paths.size == 1 ? '' : 's'} into #{output_path}..."
    t_merge = Process.clock_gettime(Process::CLOCK_MONOTONIC)
    Rhymecrime::LocalStore.open_for_write(output_path, transaction: false) do |writer|
      shard_paths.each do |p|
        writer.merge_shard(p) if p && File.exist?(p)
      end
    end
    merge_elapsed = Process.clock_gettime(Process::CLOCK_MONOTONIC) - t_merge
    size_mb = (File.size(output_path).to_f / (1024 * 1024)).round(1)
    puts "Merged into #{output_path} (#{size_mb} MB) in #{format('%.1f', merge_elapsed)}s."
    shard_paths.each { |p| File.delete(p) if p && File.exist?(p) }
  end
end

elapsed = Process.clock_gettime(Process::CLOCK_MONOTONIC) - run_started_at
hh = (elapsed / 3600).to_i
mm = ((elapsed % 3600) / 60).to_i
ss = (elapsed % 60)
puts "Finished #{n} lemmas in #{hh}h #{mm}m #{format('%.1f', ss)}s wall clock with #{threads} worker#{threads == 1 ? '' : 's'}."
