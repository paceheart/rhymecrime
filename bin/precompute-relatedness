#!/usr/bin/env ruby
# frozen_string_literal: true

# Pre-compute thematically related headword lists per distinct lemma (same cue set as dict-build’s
# “preferred common base forms with rhymes” line: common lemma headword, +preferred_form+ surface,
# +headword_has_nonidentical_rhyme_partner?+). Skips ~35k lemma keys down to ~20k cues vs scanning
# every common lemma row from the CSV alone.
# Computation uses only local generated/ files (no RHYMECRIME_DATA_SOURCE=dynamodb).
# Always writes JSONL to generated/ (default: related_precompute.jsonl); upload with bin/upload-to-dynamodb.
#
#   ruby bin/precompute-relatedness
#
# Options:
#   --output=PATH          Override output path (default: generated/related_precompute.jsonl)
#   --dry-run              Compute only; print progress, do not write a file
#   --max-cues=N           Only process first N lemmas (smoke test)
#   --start-after=WORD     Skip lemmas until after this string (lexicographic)
#
# OOV Numberbatch: headwords whose dictionary lemma has no row in generated/numberbatch_vectors.msgpack
# skip the expensive full relatedness scan (see +dictionary_lemma_has_numberbatch_vector?+ in related.rb).
# Set RHYMECRIME_WARN_OOV_NUMBERBATCH=1 to print a line to stderr for each such headword.

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

ENV.delete("RHYMECRIME_DATA_SOURCE")

require "json"
require "optparse"
require_relative "../lib/rhymecrime/dict/utils_rhyme"
require_relative "../lib/rhymecrime/frontend"
require_relative "../lib/rhymecrime/dict/rime"

output_path = generated_dict_path(RELATED_PRECOMPUTE_JSONL_FILENAME)
dry_run = false
max_cues = nil
start_after = nil

OptionParser.new do |o|
  o.on("--output=PATH", "JSONL output path") { |p| output_path = File.expand_path(p) }
  o.on("--dry-run", "Compute only; do not write") { dry_run = true }
  o.on("--max-cues=N", Integer) { |n| max_cues = n }
  o.on("--start-after=WORD") { |w| start_after = w }
end.parse!

word_path = generated_dict_path(WORD_DICT_FILENAME)
unless File.exist?(word_path)
  warn "Missing #{word_path}"
  exit 1
end

# lemma -> one representative common headword (prefer self-lemma)
rep = {}
File.foreach(word_path, encoding: "UTF-8") do |line|
  next unless useful_line?(line)

  parts = line.chomp.split(",", 4)
  word = parts[0].desanitize
  freq = parts[1].to_i
  next if freq <= RARE_FREQ_MAX

  lemma_raw = parts[3]
  lem = (lemma_raw && !lemma_raw.strip.empty?) ? lemma_raw.strip.desanitize : word

  rep[lem] ||= word
  rep[lem] = lem if word == lem
end

wd = word_dict
rd = rdict
before_n = rep.size
lemmas = rep.keys.select do |lem|
  next false unless wd.key?(lem)

  word_common_preferred_headword?(lem, wd) &&
    headword_has_nonidentical_rhyme_partner?(lem, wd[lem]&.dig(1), rd, wd)
end.sort
lemmas.select! { |l| l > start_after } if start_after
lemmas = lemmas.first(max_cues) if max_cues

n = lemmas.size
puts "Precompute cues: #{n} preferred common lemmas with rhymes (#{before_n} distinct common lemmas in word_dict before filter)"
puts "Scanning #{n} lemmas → #{dry_run ? '(dry-run, no file)' : output_path} (JSONL only when ≥1 related word)"

RelatedWords.instance_variable_set(:@related_word_cache, {})

jsonl_io = nil
jsonl_io = File.open(output_path, "w", encoding: "UTF-8") unless dry_run

# Elapsed-average ETA: linear extrapolation from items completed so far.
t0 = Process.clock_gettime(Process::CLOCK_MONOTONIC)

begin
  lemmas.each_with_index do |lem, i|
    words = RelatedWords.find_all_thematically_related_words(lem, false, true)
    next if words.empty?

    if (i % 50).zero?
      done = i + 1
      elapsed = Process.clock_gettime(Process::CLOCK_MONOTONIC) - t0
      remaining = n - done
      eta_suffix =
        if remaining.positive? && done.positive? && elapsed.positive?
          eta_sec = [(remaining.to_f * elapsed / done).round, 0].max
          eh = eta_sec / 3600
          em = (eta_sec % 3600) / 60
          "~#{eh}h #{em}m remaining"
        else
          ""
        end
      paren = eta_suffix.empty? ? "" : " (#{eta_suffix})"
      puts "  [#{i}/#{n}] #{lem}: #{words.size} related#{paren}"
    end
    next if dry_run

    pk = "related##{lem}"
    jsonl_io.puts(JSON.generate("pk" => pk, "words" => words))
  end
ensure
  jsonl_io&.close
end

puts "Finished."
