#!/usr/bin/env ruby
# encoding: utf-8
#
# Scans conceptnet-assertions*.csv.gz and writes a gzip of every English lemma on a kept relation edge.
# Normally unnecessary: setup.sh runs this after downloading assertions; dict-build auto-builds the
# cache if it is missing or older than assertions. Use this script to refresh the cache without a full dict-build.
#
#   ./bin/preprocess-conceptnet-lemma-cache
#   ./bin/preprocess-conceptnet-lemma-cache /path/to/out.en-kept-lemmas.txt.gz
#
# Default output: <repo>/generated/<assertions-basename>.en-kept-lemmas.txt.gz
#
# CONCEPTNET_ASSERTIONS_GZ=/path/to/file.csv.gz
# CONCEPTNET_LEMMA_CACHE_GZ=/path/to/cache.gz
#

repo = File.expand_path("..", __dir__)
dict_dir = File.join(repo, "lib", "rhymecrime", "dict")
$LOAD_PATH.unshift File.join(repo, "lib")

Dir.chdir(dict_dir) do
  load File.join(dict_dir, "utils_rhyme.rb")
  out = ARGV[0]
  build_conceptnet_lemma_cache!(output_path: (out && !out.empty? ? out : nil))
end
