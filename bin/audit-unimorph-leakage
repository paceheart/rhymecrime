#!/usr/bin/env ruby
# encoding: utf-8
# frozen_string_literal: true
#
# Bridge between bin/audit-unimorph (which compares Inflect.each_derivable_form against
# UniMorph) and reality (the surfaces that actually live in generated/word_dict.txt).
#
# bin/audit-unimorph counts disagreements at the *generator* layer. Many spurious
# generations are filtered later by morphology.rb policy gates and never make it into
# word_dict.txt. This script answers the harder question: of the disagreements UniMorph
# would have prevented, how many leaked all the way into the published dictionary?
#
# For every dictionary base B that UniMorph also lists as a lemma, and every kind
# k ∈ {:s, :ed, :ing, :er, :est}, we compute:
#   I_k_full   = Inflect.each_derivable_form(B) restricted to kind k
#   U_k        = UniMorph forms for B at kind k
#   live_forms = subset of I_k_full that ALSO appears as a headword in word_dict.txt
#                (i.e., what really shipped)
#
# Disagreements are classified the same way as the upstream audit (spurious_doubling,
# spurious_other, missed_doubling, missed_other) and then split into "live" (in
# word_dict.txt) vs "filtered" (generator-only).

require "set"

repo = File.expand_path("..", __dir__)
$LOAD_PATH.unshift File.join(repo, "lib")

require "rhymecrime/dict/utils_rhyme"
require "rhymecrime/dict/inflect"

UNIMORPH_PATH  = File.join(repo, "corpora", "unimorph", "eng")
WORD_DICT_PATH = File.join(repo, "generated", "current", "word_dict.txt")

MSD_TO_KIND = {
  "N;PL" => :s, "V;PRS;3;SG" => :s,
  "V;PST" => :ed, "V;V.PTCP;PST" => :ed,
  "V;V.PTCP;PRS" => :ing,
  "ADJ;CMPR" => :er,
  "ADJ;SPRL" => :est,
}.freeze

KIND_ORDER = %i[s ed ing er est].freeze

def load_unimorph(path)
  by_base = Hash.new { |h, k| h[k] = Hash.new { |hh, kk| hh[kk] = Set.new } }
  File.foreach(path, encoding: "UTF-8") do |line|
    line.chomp!
    next if line.empty?
    lemma, form, msd = line.split("\t")
    next if lemma.nil? || form.nil? || msd.nil? || lemma == form
    k = MSD_TO_KIND[msd]
    next unless k
    by_base[lemma][k].add(form)
  end
  by_base
end

# Two views of word_dict.txt:
#   bases:     headwords with no LEMMA field (own-lemma rows).
#   all_words: every headword (live entries with non-empty pron field).
def load_word_dict(path)
  bases = Set.new
  all_words = Set.new
  File.foreach(path, encoding: "UTF-8") do |line|
    next if line.empty? || line.start_with?("#")
    line.chomp!
    fields = line.split(",")
    next if fields.size < 3
    word = fields[0]
    pron = fields[2] || ""
    next if word.empty?
    all_words.add(word)
    bases.add(word) if fields.size < 4 || fields[3].empty?
  end
  [bases, all_words]
end

def doubled_consonant_form?(base, form, suffix)
  return false if base.empty?
  lc = base[-1]
  return false unless lc && lc.match?(/\A[bcdfghjklmnpqrstvwxz]\z/i)
  form == base + lc + suffix
end

def plain_suffix_form?(base, form, suffix)
  form == base + suffix
end

def classify(base, form, kind, side)
  letters = case kind
            when :s then %w[s es]
            when :ed then %w[ed]
            when :ing then %w[ing]
            when :er then %w[er]
            when :est then %w[est]
            end
  doubled = letters.any? { |s| doubled_consonant_form?(base, form, s) }
  plain   = letters.any? { |s| plain_suffix_form?(base, form, s) }
  case side
  when :inflect_only
    doubled ? :spurious_doubling : :spurious_other
  when :unimorph_only
    doubled ? :missed_doubling : (plain ? :missed_other : :missed_other)
  end
end

puts "Loading UniMorph..."
unimorph = load_unimorph(UNIMORPH_PATH)
puts "  #{unimorph.size} lemmas with inflected MSD rows."

puts "Loading word_dict.txt..."
bases, all_words = load_word_dict(WORD_DICT_PATH)
puts "  #{bases.size} bases, #{all_words.size} total headwords."

universe = bases & unimorph.keys.to_set
puts "Comparing on #{universe.size} bases..."

Inflect.configure_wordnet_db_path!

live_counts = Hash.new(0)
filtered_counts = Hash.new(0)
live_examples = Hash.new { |h, k| h[k] = [] }

n = 0
universe.each do |base|
  n += 1
  $stderr.puts "  #{n} / #{universe.size}" if (n % 5_000).zero?

  inflect_by_kind = Hash.new { |h, k| h[k] = Set.new }
  Inflect.each_derivable_form(base) do |w|
    next if w == base
    k = Inflect.send(:match_suffix_kind, base, w)
    next unless KIND_ORDER.include?(k)
    inflect_by_kind[k].add(w)
  end

  KIND_ORDER.each do |k|
    i_set = inflect_by_kind[k]
    u_set = unimorph[base][k] || Set.new

    (i_set - u_set).each do |form|
      bucket = classify(base, form, k, :inflect_only)
      if all_words.include?(form)
        live_counts[bucket] += 1
        live_examples[bucket] << [base, form] if live_examples[bucket].size < 25
      else
        filtered_counts[bucket] += 1
      end
    end
    (u_set - i_set).each do |form|
      bucket = classify(base, form, k, :unimorph_only)
      if all_words.include?(form)
        live_counts[bucket] += 1
        live_examples[bucket] << [base, form] if live_examples[bucket].size < 25
      else
        filtered_counts[bucket] += 1
      end
    end
  end
end

puts ""
puts "=" * 78
puts "Disagreement leakage into generated/word_dict.txt"
puts ""
puts "%-22s | %-10s | %-10s | %s" % ["bucket", "live", "filtered", "leak %"]
puts "-" * 70
%i[spurious_doubling spurious_other missed_doubling missed_other].each do |b|
  l = live_counts[b]
  f = filtered_counts[b]
  total = l + f
  pct = total.zero? ? 0.0 : l * 100.0 / total
  puts "%-22s | %-10d | %-10d | %.1f" % [b, l, f, pct]
end

puts ""
puts "Live samples (already in word_dict.txt — these are real shipping bugs):"
puts ""
%i[spurious_doubling missed_doubling spurious_other missed_other].each do |b|
  rows = live_examples[b]
  next if rows.empty?
  puts "[#{b}] #{live_counts[b]} live disagreement#{live_counts[b] == 1 ? '' : 's'} (showing #{rows.size}):"
  rows.each { |base, form| puts "  #{base.ljust(24)} → #{form}" }
  puts ""
end
