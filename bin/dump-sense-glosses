#!/usr/bin/env ruby
# frozen_string_literal: true
#
# Dump (lemma, sense_idx, text) triples as JSONL for external sentence-transformer
# encoding (bin/build-sense-vectors.py). Output feeds into
# generated/<timestamp>/model_sense_vectors.msgpack which supplies the modern-embedding
# signals in PairSignals (see MODEL_SENSE_VECTORS_FILENAME, related.rb).
#
# Each headword contributes:
#   - one "headword" item (sense_idx = -1, text is just the headword itself)
#   - one "definition" item (sense_idx = -2, text is the headword followed by
#     all its WordNet *and* Wiktionary glosses pooled into a single
#     sentence-transformer input, "{word}. {gloss1}. {gloss2}. ..."). This gives
#     the encoder a *definition-aware* embedding that disambiguates polysemous
#     bare words ("bear"-the-animal vs "bear"-the-verb) — feeds the def_cos
#     classifier feature. Falls back to the bare headword text when no glosses
#     are available, so definition[word] is always populated for in-vocab
#     lemmas.
#   - up to --max-senses "sense" items (sense_idx >= 0), one per gloss drawn
#     from WordNet first then Wiktionary (text is "{word}: {gloss}").
# When a word has no direct WordNet senses, we try morphy-resolved inflected forms
# (same fallback as sense_vectors_morphy); Wiktionary glosses don't need that
# fallback because the Kaikki dump already keys by the surface form.
#
# Scope:
#   --limit-csv CSV  only dump words referenced in the CSV's cue/related columns.
#                      Useful for iterating on curated/related.csv fast.
#   default            all dictionary base lemmas with Numberbatch vectors (~65k; Python
#                      encoding this many at MPNet pace is ~30 min on Apple Silicon MPS).
#
#   ruby bin/dump-sense-glosses --limit-csv curated/related.csv
#   ruby bin/dump-sense-glosses                    # everything
#   ruby bin/dump-sense-glosses --max-senses 6 --output /tmp/glosses.jsonl

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

ENV.delete("RHYMECRIME_DATA_SOURCE")

require "json"
require "optparse"
require "set"

options = {
  limit_csv: nil,
  max_senses: (ENV["RHYMECRIME_SENSE_VECTOR_CAP"] || "4").to_i, # mirrors SENSE_VECTOR_MAX_SENSES
  include_morphy: true,
  output: nil,
}

OptionParser.new do |opt|
  opt.on("--limit-csv PATH") { |v| options[:limit_csv] = v }
  opt.on("--max-senses N", Integer) { |v| options[:max_senses] = v }
  opt.on("--no-morphy") { options[:include_morphy] = false }
  opt.on("--output PATH") { |v| options[:output] = v }
end.parse!

repo = File.expand_path("..", __dir__)
Dir.chdir(repo)

require "rhymecrime/crime"
# Numberbatch loader + WordNet setup live in relatedness/signals (they're not
# pulled in by rhymecrime/crime anymore); this script iterates Numberbatch
# keys and WordNet lemmas/morphy, so require them explicitly.
require "rhymecrime/relatedness/signals"
require "rwordnet"

options[:output] ||= generated_stamp_path("sense_glosses.jsonl")

lemmas = Set.new
if options[:limit_csv]
  require "csv"
  rows = CSV.parse(BuildIo.read(options[:limit_csv], encoding: "UTF-8", hint: "dump-sense-glosses limit_csv"), headers: true)
  rows.each do |r|
    %w[cue related].each do |col|
      next unless r[col]
      w = r[col].to_s.strip
      next if w.empty?
      lemmas << lemma(w)
    end
  end
else
  # Every lemma with a Numberbatch row — the existing base-lemma universe.
  numberbatch.each_key do |key|
    lemmas << key.to_s.tr("_", "-")
  end
end

lemmas.reject! { |l| semantically_promiscuous?(l) || l.nil? || l.empty? }
STDERR.puts "collected #{lemmas.size} lemmas"

def wordnet_glosses_for(word, max_senses, include_morphy)
  return [] unless gloss_source_use_wordnet?
  glosses = []
  WordNet::Lemma.find_all(word).each do |lem|
    lem.synsets.each do |synset|
      return glosses if glosses.size >= max_senses
      glosses << synset.gloss
    end
  end

  return glosses unless glosses.empty? && include_morphy

  morphs = (WordNet::Synset.morphy_all(word) rescue []).uniq - [word]
  morphs.each do |form|
    WordNet::Lemma.find_all(form).each do |lem|
      lem.synsets.each do |synset|
        return glosses if glosses.size >= max_senses
        glosses << synset.gloss
      end
    end
  end
  glosses
end

# Combined WordNet + Wiktionary gloss list for word, capped at max_senses entries.
# WordNet first (more concise / hand-curated); Wiktionary fills remaining slots.
# Pointer-only Wiktionary senses ("Alternative spelling of X") are already
# excluded at build time by collect_definitional_glosses. Dedupes case-folded
# gloss text so a corpus that happens to repeat a definition verbatim doesn't
# crowd out a different sense from the other corpus.
def combined_glosses_for(word, max_senses, include_morphy)
  glosses = wordnet_glosses_for(word, max_senses, include_morphy)
  return glosses if glosses.size >= max_senses
  seen = glosses.each_with_object(Set.new) { |g, s| s << g.to_s.downcase.strip }
  wiktionary_glosses_for(word).each do |g|
    break if glosses.size >= max_senses
    key = g.to_s.downcase.strip
    next if key.empty? || seen.include?(key)
    seen << key
    glosses << g
  end
  glosses
end

# Pooled-definition text fits comfortably in MPNet's 512-token input even for the
# most polysemous lemmas (~10 short glosses). We don't bother truncating; encoder
# already handles overflow by truncation if it ever happened.
def pooled_definition_text(word, glosses)
  return word if glosses.empty?
  parts = glosses.map { |g| g.to_s.strip.chomp(".") }
  parts.reject!(&:empty?)
  return word if parts.empty?
  "#{word}. #{parts.join('. ')}."
end

written = 0
headword_only = 0
BuildIo.open(options[:output], "w", hint: "dump-sense-glosses jsonl") do |f|
  lemmas.sort.each do |word|
    f.puts JSON.generate("word" => word, "sense_idx" => -1, "text" => word)
    written += 1

    glosses = combined_glosses_for(word, options[:max_senses], options[:include_morphy])
    headword_only += 1 if glosses.empty?

    # Only emit a definition embedding when there's an *actual* gloss. Otherwise
    # pooled_definition_text would fall back to the bare headword, producing a
    # vector ~identical to the sense_idx=-1 headword embedding — making
    # def_cos effectively redundant with model_cos for senseless words and
    # destroying the def_in_vocab gate's signal value. Senseless words now get
    # definition[word] = nil in the encoded msgpack, so def_both_in_vocab?
    # correctly returns false for any pair touching them.
    unless glosses.empty?
      f.puts JSON.generate(
        "word" => word,
        "sense_idx" => -2,
        "text" => pooled_definition_text(word, glosses),
      )
      written += 1
    end

    glosses.each_with_index do |g, i|
      f.puts JSON.generate(
        "word" => word,
        "sense_idx" => i,
        "text" => "#{word}: #{g}",
      )
      written += 1
    end
  end
end

STDERR.puts "wrote #{written} items to #{options[:output]}"
STDERR.puts "#{headword_only} lemmas had no WordNet or Wiktionary senses (headword-only)"
