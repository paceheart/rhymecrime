#!/usr/bin/env bash
#
# Orchestrates the three stages of the relatedness pipeline:
#
#   1. bin/dump-sense-glosses            → $RHYMECRIME_BUILD_DIR/sense_glosses.jsonl
#   2. bin/build-sense-vectors.py        → $RHYMECRIME_BUILD_DIR/model_sense_vectors.msgpack
#   3. bin/train-relatedness-classifier  → $RHYMECRIME_BUILD_DIR/relatedness_classifier.json
#
# Default invocation only runs stage 3 (fast; ~1 min). Stages 1-2 are ~20 min on
# CPU for the full dictionary, so we only redo them when told to.
#
# Typical usage:
#   bin/retrain-relatedness                      # refit classifier on existing features
#   bin/retrain-relatedness --rebuild-vectors    # also re-encode MPNet sense vectors
#   bin/retrain-relatedness --model logreg       # passthrough to the Ruby trainer
#   bin/retrain-relatedness --rebuild-vectors --model gbt --trees 400
#
# Stages 1-2 need rebuilding when:
#   - the dictionary changes (new headwords / WordNet update)
#   - the dump template changes (bin/dump-sense-glosses)
#   - you swap models (bin/build-sense-vectors.py --model ...)
#   - SENSE_VECTOR_MAX_SENSES changes
#
# Stage 3 alone is enough when:
#   - you edit LEARNED_FEATURE_NAMES / PairSignals / learned_feature_vector
#   - you tweak hyperparameters
#   - you modify curated/related.csv (the training labels)

set -euo pipefail

if [[ -z "${RHYMECRIME_BUILD_DIR:-}" ]]; then
  echo "error: RHYMECRIME_BUILD_DIR is not set. Run ./bin/build or export it to a timestamp directory under generated/." >&2
  exit 1
fi

REBUILD_VECTORS=0
PASSTHROUGH=()

for arg in "$@"; do
  case "$arg" in
    --rebuild-vectors) REBUILD_VECTORS=1 ;;
    -h|--help)
      sed -n '3,29p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *) PASSTHROUGH+=("$arg") ;;
  esac
done

REPO="$(cd "$(dirname "$0")/.." && pwd -P)"
cd "$REPO"

if [[ $REBUILD_VECTORS -eq 1 ]]; then
  # The .venv (sentence-transformers + msgpack for MPNet encoding) is
  # provisioned by setup.sh / bin/setup-python-venv. Hard-assert it's healthy
  # here so a missing or broken venv fails fast with a single clear pointer
  # rather than later inside .venv/bin/python bin/build-sense-vectors.py.
  if [[ ! -x .venv/bin/python ]] || \
     ! .venv/bin/python -c 'import sentence_transformers, msgpack' >/dev/null 2>&1; then
    echo "error: .venv is missing or its dependencies aren't importable." >&2
    echo "  run: ./bin/setup-python-venv         (or ./setup.sh, which calls it)" >&2
    exit 1
  fi

  # Sub-stages use letters (a/b/c) so they read as sub-bullets when invoked
  # from bin/build (which prints its own "Build Stage N/4:" parent banners)
  # and don't masquerade as a competing top-level numbering scheme when run
  # standalone.
  echo "==> (a) dumping sense glosses -> ${RHYMECRIME_BUILD_DIR}/sense_glosses.jsonl"
  ruby bin/dump-sense-glosses
  echo "==> (b) encoding sense vectors -> ${RHYMECRIME_BUILD_DIR}/model_sense_vectors.msgpack"
  .venv/bin/python bin/build-sense-vectors.py
fi

echo "==> (c) training classifier -> ${RHYMECRIME_BUILD_DIR}/relatedness_classifier.json"
if [[ ${#PASSTHROUGH[@]} -eq 0 ]]; then
  exec ruby bin/train-relatedness-classifier
else
  exec ruby bin/train-relatedness-classifier "${PASSTHROUGH[@]}"
fi
