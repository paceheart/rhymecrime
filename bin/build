#!/usr/bin/env bash
#
# Full RhymeCrime build pipeline. One timestamped directory under generated/
# holds bootstrap/, runtime/, training intermediates, and BUILD_INFO.json.
# When generated/current is linked to a runtime/, word_dict.txt and rime_dict.txt
# are also copied to published/ for git-friendly snapshots.
#
#   bin/build [--dict-only]
#
# Dictionary compile is run inline by this script (Ruby load dict.rb).
# Env: RHYMECRIME_BUILD_DIR, RHYMECRIME_BUILD_MODE, optional RHYMECRIME_RARITY_DUMP_SIGNALS.
#
# Build stages (full pipeline):
#   0. augment-related-from-feedback — optionally fold web feedback into curated/related.csv
#   1/4. dictionary compile (bootstrap) — rarity signal dump → bootstrap/
#   2/4. train-rarity-classifier → bootstrap/rarity_classifier.json
#   3/4. retrain-relatedness --rebuild-vectors — sense glosses + MPNet + relatedness classifier
#   4/4. dictionary compile (final) — rarity classifier rescore, runtime artifacts → runtime/
#
# Prereqs (one-time): ./setup.sh
#   (creates generated/conceptnet_edges.msgpack and
#    generated/numberbatch_vectors.msgpack from their source corpora)

set -euo pipefail

REPO="$(cd "$(dirname "$0")/.." && pwd -P)"
cd "$REPO"

DICT_ONLY=0
while [ $# -gt 0 ]; do
  case "$1" in
    --dict-only) DICT_ONLY=1 ;;
    -h|--help)
      cat <<'USAGE'
bin/build                  Full pipeline: augment, corpus preflight, dictionary bootstrap+final,
                           train rarity + prefix classifiers, retrain relatedness, prefix gate,
                           link generated/current and refresh published/*.txt lexicon mirrors.

bin/build [--dict-only]    Solo lexicon rebuild (omit the flag for full pipeline): reuses
                           classifiers + model_sense_vectors.msgpack from the prior
                           generated/current stamp when a new timestamp dir is created;
                           skips Python/MPNet preflight. Sets RHYMECRIME_BUILD_MODE to
                           final when unset; updates generated/current (and published/*.txt)
                           after a final compile.

Environment (both modes): RHYMECRIME_BUILD_DIR, RHYMECRIME_BUILD_MODE, RHYMECRIME_BUILD_IO_VALIDATE
USAGE
      exit 0
      ;;
    *)
      echo "bin/build: unknown option: $1" >&2
      echo "usage: bin/build [--dict-only]" >&2
      exit 1
      ;;
  esac
  shift
done

run_dict_inner() {
  BIN_BUILD_DICT_REPO_ROOT="$REPO" ruby -I"$REPO/lib" -e '
repo = ENV.fetch("BIN_BUILD_DICT_REPO_ROOT")
dict_dir = File.join(repo, "lib", "rhymecrime", "build")
$LOAD_PATH.unshift File.join(repo, "lib")
Dir.chdir(dict_dir) do
  load File.join(dict_dir, "dict.rb")
  rebuild_rhymecrime_dictionaries
end
'
}

# Corpus + cache preflight shared by full build and --dict-only.
# Set BIN_BUILD_PREFLIGHT_PHASE=dict_only to skip Python/MPNet deps (solo lexicon rebuild).
run_corpus_preflight() {
  (
    export BIN_BUILD_PREFLIGHT_PHASE="${BIN_BUILD_PREFLIGHT_PHASE:-full}"
    ruby -I"$REPO/lib" <<'RUBY'
require "rhymecrime/build/build_utils"

repo = File.expand_path(Dir.pwd)
errors = []
dict_only_preflight = ENV["BIN_BUILD_PREFLIGHT_PHASE"] == "dict_only"

require_nonempty = lambda do |label, path, fix|
  unless File.file?(path) && File.size?(path)
    errors << "#{label} missing or empty:\n  #{path}\n  fix: #{fix}"
  end
end

require_any = lambda do |label, paths, fix|
  ok = paths.any? { |p| File.file?(p) && File.size?(p) }
  unless ok
    errors << "#{label} missing or empty (checked #{paths.size} path(s)):\n  #{paths.join("\n  ")}\n  fix: #{fix}"
  end
end

require_glob = lambda do |label, pattern, fix|
  matches = Dir.glob(pattern).select { |p| File.file?(p) && File.size?(p) }
  errors << "#{label} missing:\n  #{pattern}\n  fix: #{fix}" if matches.empty?
end

setup = "./bin/setup-corpora"
require_nonempty["CMUdict", File.join(repo, "corpora", "cmudict", "cmudict-0.7c.txt"), "restore vendored corpora/cmudict or run #{setup} if this checkout is incomplete"]
require_nonempty["Wiktionary filtered JSONL", File.join(repo, "corpora", "wiktionary", "kaikki-english-filtered.jsonl.gz"), "run #{setup}"]
require_nonempty["SUBTLEX-US TSV", File.join(repo, "corpora", "subtlex", "SUBTLEXus.tsv"), "restore vendored corpora/subtlex or run #{setup} if this checkout is incomplete"]
require_nonempty["VarCon data", File.join(repo, "corpora", "varcon", "varcon.txt"), "restore vendored corpora/varcon"]
require_nonempty["NEOL word list", File.join(repo, "corpora", "neol", "neol2016.txt"), "restore vendored corpora/neol"]
require_nonempty["wordfreq export", File.join(repo, "generated", "wordfreq.tsv"), "run #{setup}"]

%w[data.noun data.verb data.adj data.adv index.noun index.verb index.adj index.adv].each do |fn|
  require_nonempty["WordNet #{fn}", File.join(repo, "corpora", "wordnet", "3.1", "dict", fn), "restore vendored corpora/wordnet"]
end

%w[
  authoritative_pronunciations.txt
  neol_supplement.txt
  prefix.csv
  rarity.csv
  related.csv
  semantic_base.csv
  semantically_promiscuous.txt
  spelling.csv
  unrhymable_stop_words.txt
].each do |fn|
  require_nonempty["curated/#{fn}", File.join(repo, "curated", fn), "restore curated/#{fn}"]
end

require_any[
  "ConceptNet assertions",
  [
    File.join(repo, "corpora", "conceptnet", "conceptnet-assertions-5.7.0.csv.gz"),
    File.join(repo, "corpora", "conceptnet-assertions-5.7.0.csv.gz"),
    File.join(repo, "conceptnet-assertions-5.7.0.csv.gz"),
  ],
  "run #{setup} or set CONCEPTNET_ASSERTIONS_GZ to an existing .csv.gz before running bin/build",
]

require_any[
  "Numberbatch text corpus",
  [
    File.join(repo, "corpora", "numberbatch", "numberbatch-en-19.08.txt"),
    File.join(repo, "numberbatch-en-19.08.txt"),
    File.join(repo, "numberbatch-en-19.08.txt"),
  ],
  "run #{setup} or set NUMBERBATCH_TXT to an existing .txt before running bin/build",
]

unless File.file?(generated_root_path(USF_ASSOCIATIONS_FILENAME)) && File.size?(generated_root_path(USF_ASSOCIATIONS_FILENAME))
  require_glob["USF Cue_Target_Pairs shards", File.join(repo, "corpora", "usf", "Cue_Target_Pairs.*"), "restore vendored corpora/usf or run #{setup}"]
end

begin
  require_numberbatch_vectors_cache!
rescue StandardError => e
  errors << e.message
end

begin
  require_conceptnet_edges_cache!
rescue StandardError => e
  errors << e.message
end

unless dict_only_preflight
  venv_python = File.join(repo, ".venv", "bin", "python")
  if !File.executable?(venv_python)
    errors << "Python venv missing:\n  #{venv_python}\n  fix: run ./bin/setup-python-venv"
  elsif !system(venv_python, "-c", "import sentence_transformers, msgpack", out: File::NULL, err: File::NULL)
    errors << "Python venv dependencies are not importable from:\n  #{venv_python}\n  fix: run ./bin/setup-python-venv"
  end
end

if errors.any?
  warn "bin/build preflight failed (#{errors.size} issue#{errors.size == 1 ? "" : "s"}):"
  errors.each_with_index do |msg, i|
    warn "\n#{i + 1}. #{msg}"
  end
  warn "\nRun ./setup.sh for a full bootstrap, or the listed setup command(s) for targeted repair."
  exit 1
end

puts "preflight ok"
RUBY
  )
}

run_buildio_preflight() {
  echo "==> Preflight: checking BuildIo write validation"
  ruby -I"$REPO/lib" <<'RUBY'
require "rhymecrime/build/build_io"

errors = []
begin
  [
    ["bootstrap", File.join(ENV.fetch("RHYMECRIME_BUILD_DIR"), "bootstrap", ".build_io_preflight_write")],
    ["final", File.join(ENV.fetch("RHYMECRIME_BUILD_DIR"), "runtime", ".build_io_preflight_write")],
  ].each do |mode, path|
    old_mode = ENV["RHYMECRIME_BUILD_MODE"]
    ENV["RHYMECRIME_BUILD_MODE"] = mode
    BuildIo.write(path, "ok\n", hint: "bin/build preflight write probe #{mode}")
    File.delete(path) if File.exist?(path)
  ensure
    ENV["RHYMECRIME_BUILD_MODE"] = old_mode
  end
rescue StandardError => e
  errors << "BuildIo write validation failed for RHYMECRIME_BUILD_DIR:\n  #{ENV.fetch("RHYMECRIME_BUILD_DIR", "(unset)")}\n  #{e.class}: #{e.message}\n  fix: ensure bin/build is using a canonical generated/<timestamp> path and BuildIo accepts writes under both bootstrap/ and runtime/"
end

if errors.any?
  warn "bin/build preflight failed (#{errors.size} issue#{errors.size == 1 ? "" : "s"}):"
  errors.each_with_index do |msg, i|
    warn "\n#{i + 1}. #{msg}"
  end
  exit 1
end

puts "BuildIo write preflight ok"
RUBY
}

# Remove PATH (file, symlink, or directory), then ln -sfn TARGET PATH. On BSD/macOS,
# if PATH exists as a directory, a bare ln -sfn creates a symlink *inside* PATH instead
# of replacing it — breaking any code that expects PATH itself to be the symlink.
replace_path_with_symlink() {
  local target="$1"
  local path="$2"
  rm -rf "$path"
  ln -sfn "$target" "$path"
}

copy_runtime_classifiers_from_current() {
  local cur="$REPO/generated/current"
  [ -L "$cur" ] || return 0
  local bd="$1"
  local old_rt
  old_rt="$(ruby -e 'puts File.expand_path(File.readlink(ARGV[0]), File.dirname(ARGV[0]))' "$cur")"
  local f
  for f in rarity_classifier.json relatedness_classifier.json prefix_classifier.json; do
    if [ -f "$old_rt/$f" ]; then
      cp "$old_rt/$f" "$bd/runtime/$f"
    fi
  done

  # MPNet embeddings are written to the stamp root by retrain-relatedness (sibling
  # of runtime/), not under runtime/. Solo tools (e.g. compute-relatedness) resolve
  # them via dirname(realpath(current)) + model_sense_vectors.msgpack — so a fresh
  # --dict-only stamp must carry the file too, or relatedness scoring breaks.
  local old_stamp vec dest
  old_stamp="$(dirname "$old_rt")"
  vec="$old_stamp/model_sense_vectors.msgpack"
  dest="$bd/model_sense_vectors.msgpack"
  if [ -f "$vec" ] && [ ! -e "$dest" ]; then
    if ln "$vec" "$dest" 2>/dev/null; then
      echo "    hard-linked model_sense_vectors.msgpack from prior stamp ($(basename "$old_stamp"))"
    else
      replace_path_with_symlink "$(cd "$(dirname "$vec")" && pwd -P)/$(basename "$vec")" "$dest"
      echo "    symlinked model_sense_vectors.msgpack from prior stamp ($(basename "$old_stamp"))"
    fi
  elif [ ! -f "$vec" ] && [ -f "$bd/runtime/relatedness_classifier.json" ]; then
    echo "    WARN: prior build has no $vec — compute-relatedness needs MPNet vectors." >&2
    echo "          Run bin/retrain-relatedness --rebuild-vectors or full bin/build once." >&2
  fi
}

# Point generated/current at RUNTIME (see replace_path_with_symlink — expected layout
# is …/generated/current/word_dict.txt, not …/generated/current/runtime/…).
# Also mirror human-readable lexicon dumps into published/ (tracked in git).
install_generated_current_symlink() {
  local runtime="$1"
  replace_path_with_symlink "$runtime" "$REPO/generated/current"
  mkdir -p "$REPO/published"
  cp "$runtime/word_dict.txt" "$runtime/rime_dict.txt" "$REPO/published/"
  echo "    copied word_dict.txt + rime_dict.txt -> published/"
}

if [ "$DICT_ONLY" -eq 1 ]; then
  BIN_BUILD_PREFLIGHT_PHASE=dict_only run_corpus_preflight

  if [ -z "${RHYMECRIME_BUILD_DIR:-}" ]; then
    TIMESTAMP="$(date +%Y%m%dT%H%M%S)"
    BUILD_DIR="$REPO/generated/$TIMESTAMP"
    mkdir -p "$BUILD_DIR/bootstrap" "$BUILD_DIR/runtime"
    copy_runtime_classifiers_from_current "$BUILD_DIR"
    export RHYMECRIME_BUILD_DIR="$BUILD_DIR"
  else
    export RHYMECRIME_BUILD_DIR="$(ruby -e 'puts File.expand_path(ARGV[0], ARGV[1])' "${RHYMECRIME_BUILD_DIR}" "$REPO")"
    BUILD_DIR="$RHYMECRIME_BUILD_DIR"
    mkdir -p "$BUILD_DIR/bootstrap" "$BUILD_DIR/runtime"
  fi

  export RHYMECRIME_BUILD_IO_VALIDATE="${RHYMECRIME_BUILD_IO_VALIDATE:-1}"
  run_buildio_preflight

  _bm="${RHYMECRIME_BUILD_MODE:-}"
  _bm="$(printf '%s' "$_bm" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
  export RHYMECRIME_BUILD_MODE="${_bm:-final}"

  echo "==> Dictionary compile (--dict-only; RHYMECRIME_BUILD_MODE=$RHYMECRIME_BUILD_MODE)"
  run_dict_inner

  # Match full bin/build stage 5: compile-only writes [freq, prons, lemma] rows;
  # without this step the optional prefix-allow column is absent and
  # filter_out_prefix_words suppresses curated pairs like agonize/antagonize.
  if [ "$RHYMECRIME_BUILD_MODE" = "final" ]; then
    echo "==> Precompute prefix allow-list (-> word_dict column; dict-only)"
    RHYMECRIME_BUILD_DIR="$BUILD_DIR" \
      ./bin/precompute-prefix-gate
  fi

  RUNTIME="$BUILD_DIR/runtime"
  CURRENT_LINK="$REPO/generated/current"

  if [ "$RHYMECRIME_BUILD_MODE" = "final" ]; then
    install_generated_current_symlink "$RUNTIME"
    echo "==> Linked $CURRENT_LINK -> $RUNTIME"
  elif [ "$RHYMECRIME_BUILD_MODE" = "bootstrap" ]; then
    echo "bootstrap mode: left generated/current unchanged (full bin/build rotates current after final stage)."
  else
    echo "bin/build [--dict-only]: not updating generated/current (need RHYMECRIME_BUILD_MODE=final; got $RHYMECRIME_BUILD_MODE)." >&2
  fi
  exit 0
fi

echo "==> Augment: bin/augment-related-from-feedback"
./bin/augment-related-from-feedback

BIN_BUILD_PREFLIGHT_PHASE=full run_corpus_preflight

TIMESTAMP="$(date +%Y%m%dT%H%M%S)"
BUILD_DIR="$REPO/generated/$TIMESTAMP"
mkdir -p "$BUILD_DIR/bootstrap" "$BUILD_DIR/runtime"

export RHYMECRIME_BUILD_DIR="$BUILD_DIR"
export RHYMECRIME_BUILD_IO_VALIDATE="${RHYMECRIME_BUILD_IO_VALIDATE:-1}"

run_buildio_preflight

echo "==> Writing $BUILD_DIR/BUILD_INFO.json"
ruby -rjson -rtime -rsocket -e '
repo = ARGV[0]
build_dir = ARGV[1]
sha = `git -C #{repo} rev-parse HEAD 2>/dev/null`.strip
sha = "unknown" if sha.empty?
dirty = !`git -C #{repo} status --porcelain 2>/dev/null`.strip.empty?
mt = {}
%w[corpora/cmudict.dict generated/wordfreq.tsv].each do |rel|
  begin
    p = File.join(repo, rel)
    mt[rel] = File.mtime(p).utc.iso8601 if File.exist?(p)
  rescue StandardError
  end
end
info = {
  "build_id" => File.basename(build_dir),
  "git_sha" => sha,
  "git_dirty" => dirty,
  "built_at" => Time.now.utc.iso8601,
  "host" => Socket.gethostname,
  "ruby_version" => RUBY_VERSION,
  "corpus_mtimes" => mt,
}
File.write(File.join(build_dir, "BUILD_INFO.json"), JSON.pretty_generate(info) + "\n")
' "$REPO" "$BUILD_DIR"

IO_AUDIT_LOG="$BUILD_DIR/io_audit.jsonl"
: >"$IO_AUDIT_LOG"
export RHYMECRIME_BUILD_IO_LOG="$IO_AUDIT_LOG"

DUMP_PATH="$BUILD_DIR/bootstrap/rarity_signals_dump.jsonl"

echo "==> Build Stage 1/4 [3m]: dictionary bootstrap (rarity signals dump)"
echo "                    dump path: $DUMP_PATH"
RHYMECRIME_BUILD_MODE=bootstrap \
RHYMECRIME_RARITY_DUMP_SIGNALS="$DUMP_PATH" \
  run_dict_inner

echo "==> Build Stage 2/5 [7m]: training rarity classifier -> bootstrap/rarity_classifier.json"
ruby ./bin/train-rarity-classifier
replace_path_with_symlink "../bootstrap/rarity_classifier.json" "$BUILD_DIR/runtime/rarity_classifier.json"

echo "==> Build Stage 2b/5: training prefix classifier -> bootstrap/prefix_classifier.json"
ruby ./bin/train-prefix-classifier
replace_path_with_symlink "../bootstrap/prefix_classifier.json" "$BUILD_DIR/runtime/prefix_classifier.json"

echo "==> Build Stage 3/5: retrain-relatedness (sense glosses + MPNet vectors + classifier)"
./bin/retrain-relatedness --rebuild-vectors
replace_path_with_symlink "../relatedness_classifier.json" "$BUILD_DIR/runtime/relatedness_classifier.json"

echo "==> Build Stage 4/5: dictionary final (rarity-classifier rescore)"
RHYMECRIME_BUILD_MODE=final \
RHYMECRIME_BUILD_DIR="$BUILD_DIR" \
  run_dict_inner

echo "==> Build Stage 5/5: precompute prefix allow-list -> word_dict column (msgpack + txt)"
RHYMECRIME_BUILD_DIR="$BUILD_DIR" \
  ./bin/precompute-prefix-gate

echo "==> Linking generated/current -> $BUILD_DIR/runtime"
if [ -L "$REPO/generated/current" ]; then
  _PREV_TARGET="$(readlink "$REPO/generated/current")"
  replace_path_with_symlink "$_PREV_TARGET" "$REPO/generated/prev"
  echo "    rotated prev -> $_PREV_TARGET"
fi
install_generated_current_symlink "$BUILD_DIR/runtime"

echo
echo "==> Generated I/O audit (unique paths touched via BuildIo)"
ruby -I"$REPO/lib" -e 'require "rhymecrime/build/build_io"; BuildIo.print_build_report'

echo "==> Build diff (current vs prev)"
ruby "$REPO/bin/diff-builds" || true

echo
echo "build done. Run bundle exec rspec to validate."
