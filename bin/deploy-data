#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

echo "==> dict-build (skip with SKIP_DICT_BUILD=1)"
if [[ "${SKIP_DICT_BUILD:-0}" != "1" ]]; then
  ./bin/dict-build
fi

if [[ "${SKIP_COMPUTE:-0}" == "1" ]]; then
  echo "==> skip compute (SKIP_COMPUTE=1)"
else
  echo "==> compute relatedness → generated/related_compute.jsonl (long run; smoke: ruby bin/compute-relatedness --max-cues=5 --dry-run)"
  bundle exec ruby bin/compute-relatedness
fi

echo "==> upload word + rime + related to DynamoDB"
bundle exec ruby bin/upload-to-dynamodb

echo "Done."
