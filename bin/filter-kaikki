#!/usr/bin/env ruby
# frozen_string_literal: true
# Streaming filter for kaikki.org's English Wiktionary dump.
#
# Usage:
#   curl -fL "https://kaikki.org/dictionary/English/kaikki.org-dictionary-English.jsonl" \
#     | bin/filter-kaikki \
#     | gzip > corpora/wiktionary/kaikki-english-filtered.jsonl.gz
#
# The raw dump is ~1.5 GB; this filter keeps only the fields dict-build needs,
# so the gzipped output stays around 50 MB. We retain:
#   word, pos                   -- identity + POS gate
#   sounds[{ipa, tags}]          -- IPA pronunciations (GA/RP disambiguation)
#   forms[{form, tags}]          -- inflection paradigm (past/plural/etc.)
#   senses[{tags, glosses[0..N], alt_of[{word}], form_of[{word}]}]
#                                -- alt-spelling / misspelling / form-of pointers
#                                   that let corpus_variants.rb recognize
#                                   Wiktionary-attested spelling variants without
#                                   runtime cost, plus definitional gloss text
#                                   that feeds the gloss-containment, per-sense
#                                   Numberbatch, MPNet per-sense and pooled-
#                                   definition signals (signals.rb,
#                                   bin/dump-sense-glosses).
#
# Every other field in the raw dump is dropped. A record survives iff it
# contributes at least one of: a pronunciation, an inflectional form, an
# alt_of/form_of pointer, or a definitional gloss. Default cutoffs for the gloss
# side were tuned against the relatedness classifier on curated/related.csv;
# see the remaining RHYMECRIME_KAIKKI_* env vars below for the knobs we swept
# and notes/wiktionary-glosses-experiments.canvas for the results.

require "json"

$stdin.set_encoding("UTF-8")
$stdout.set_encoding("UTF-8")

# Per-sense gloss cap. ~99.7% of senses in kaikki have exactly 1 gloss anyway,
# so a value >1 only widens the long tail; default 5 captures the few
# multi-gloss senses without bloating output.
GLOSSES_PER_SENSE = (ENV["RHYMECRIME_KAIKKI_GLOSSES_PER_SENSE"] || "5").to_i
# Per-gloss char truncation. Most glosses are <200 chars; long technical /
# legal definitions hit the cap. Default 500 keeps them while staying under
# MPNet's 512-token input.
GLOSS_CHAR_LIMIT = (ENV["RHYMECRIME_KAIKKI_GLOSS_CHAR_LIMIT"] || "500").to_i
# Keep records whose only signal is a definitional gloss (no pronunciation /
# form / variant pointer). The original filter dropped these — that loses 833K
# of 1.46M raw records (57%) and explains why most CMUDict-only headwords had
# no Wiktionary gloss available in earlier builds. Always true now (the legacy
# variant-discovery-only corpus is no longer reachable from this script).

ARGF.each_line do |line|
  obj = begin
    JSON.parse(line)
  rescue JSON::ParserError
    next
  end

  word = obj["word"]
  pos = obj["pos"]
  next if word.nil? || word.empty? || pos.nil? || pos.empty?

  # Drop nonstandard-tagged transcriptions: Wiktionary editors flag stigmatized
  # / hyper-local / reading-spelling renderings (/məˈdam/ for "madam",
  # /foʊlks/ for "folks", [ˈtɛt.nɪ.kl̩] for Southern-US "technical"). They
  # add noise to rhyme buckets without giving us a broadly accepted reading we
  # don't already have from a sibling sounds row. ~0.12% of dump rows.
  sounds = (obj["sounds"] || []).select do |s|
    next false unless s.is_a?(Hash) && s["ipa"]
    next false if (s["tags"] || []).include?("nonstandard")
    true
  end
  kept_sounds = sounds.map { |s| { "ipa" => s["ipa"], "tags" => s["tags"] || [] } }

  forms = (obj["forms"] || []).select { |f| f.is_a?(Hash) && f["form"] && f["tags"] }
  kept_forms = forms.map { |f| { "form" => f["form"], "tags" => f["tags"] } }

  kept_senses = []
  (obj["senses"] || []).each do |s|
    next unless s.is_a?(Hash)
    alt_of = (s["alt_of"] || []).map { |x| x.is_a?(Hash) ? { "word" => x["word"] } : nil }.compact
    form_of = (s["form_of"] || []).map { |x| x.is_a?(Hash) ? { "word" => x["word"] } : nil }.compact
    tags = s["tags"] || []
    # Only keep a gloss when it's the key evidence -- the alt_of/form_of pointers
    # are machine-readable, but plenty of variants are only signaled by a gloss
    # like "Alternative spelling of X." Cap to the first gloss, truncated, to
    # keep the output small.
    glosses = (s["glosses"] || [])[0, GLOSSES_PER_SENSE].map { |g| g.to_s[0, GLOSS_CHAR_LIMIT] }
    next if alt_of.empty? && form_of.empty? && tags.empty? && glosses.empty?
    sense = {}
    sense["tags"] = tags unless tags.empty?
    sense["glosses"] = glosses unless glosses.empty?
    sense["alt_of"] = alt_of unless alt_of.empty?
    sense["form_of"] = form_of unless form_of.empty?
    kept_senses << sense
  end

  # A record is worth keeping iff downstream can consume something from it.
  # Pronunciations feed wiktionary.rb's pron_hash; forms feed forms_map;
  # alt_of/form_of senses feed corpus_variants.rb's variant discovery.
  has_variant_signal = kept_senses.any? { |s| s["alt_of"] || s["form_of"] }
  has_definitional_gloss = kept_senses.any? do |s|
    g = s["glosses"]
    g && !g.empty?
  end
  next if kept_sounds.empty? && kept_forms.empty? && !has_variant_signal && !has_definitional_gloss

  out = { "word" => word, "pos" => pos }
  out["sounds"] = kept_sounds unless kept_sounds.empty?
  out["forms"] = kept_forms unless kept_forms.empty?
  out["senses"] = kept_senses unless kept_senses.empty?
  $stdout.puts(JSON.generate(out))
end
