#!/usr/bin/env ruby
# encoding: utf-8
#
# Rebuild RhymeCrime caches under <repo>/generated/. Fast-path default: skips
# the slow ConceptNet edge-map and Numberbatch vector exports (~15-20 min)
# and the rarity-signals dump (~30 s extra plus disk I/O). Use bin/build for
# the full four-Build-Stage pipeline (dict-build full + rarity classifier +
# relatedness training + rarity-classifier rescore) — or set the override env
# vars below to opt in piecemeal.
#
# Loads lib/rhymecrime/dict/dict.rb (which requires constants, phonology, lexical,
# morphology, rime, frequency) with cwd = that directory (relative list files),
# then runs rebuild.
#
#   ./bin/dict-build                                              # slim default
#   RHYMECRIME_DICT_BUILD_CONCEPTNET_NUMBERBATCH=1 ./bin/dict-build  # +CN+NB exports
#   RHYMECRIME_RARITY_DUMP_SIGNALS=PATH         ./bin/dict-build  # +rarity signal dump
#                                                                 # (+ disables rescore)
#
# CPU sampling profile (StackProf): ./bin/dict-build-profile — see script header for STACKPROF_* env vars.
#
# ConceptNet lemma cache (generated/*.en-kept-lemmas.txt.gz) is built by setup.sh after downloading
# assertions, or automatically at the start of dict-build if missing/stale. Optional manual refresh:
#   ./bin/preprocess-conceptnet-lemma-cache
#

repo = File.expand_path("..", __dir__)
dict_dir = File.join(repo, "lib", "rhymecrime", "dict")
$LOAD_PATH.unshift File.join(repo, "lib")

Dir.chdir(dict_dir) do
  load File.join(dict_dir, "dict.rb")
  rebuild_rhymecrime_dictionaries
end
