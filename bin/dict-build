#!/usr/bin/env ruby
# encoding: utf-8
#
# Rebuild RhymeCrime caches. When RHYMECRIME_BUILD_DIR is unset, creates a new
# generated/<UTC-timestamp>/ tree and runs in final mode (slim default).
# Use bin/build for the full pipeline (bootstrap + train + relatedness + final).
#
# Loads lib/rhymecrime/build/dict.rb with cwd = that directory, then runs rebuild.
#
#   ./bin/dict-build                                # slim default
#   RHYMECRIME_RARITY_DUMP_SIGNALS=PATH ./bin/dict-build  # rarity signal dump
#
# Corpus-derived caches live under generated/ root, not generated/current/.
# setup-corpora creates the large stable mirrors (numberbatch_vectors.msgpack,
# conceptnet_edges.msgpack); dict-build only verifies those are present/current.

require "fileutils"

repo = File.expand_path("..", __dir__)
dict_dir = File.join(repo, "lib", "rhymecrime", "build")
$LOAD_PATH.unshift File.join(repo, "lib")

if !ENV["RHYMECRIME_BUILD_DIR"] || ENV["RHYMECRIME_BUILD_DIR"].empty?
  ts = Time.now.utc.strftime("%Y%m%dT%H%M%S")
  bd = File.join(repo, "generated", ts)
  FileUtils.mkdir_p(File.join(bd, "bootstrap"))
  FileUtils.mkdir_p(File.join(bd, "runtime"))
  ENV["RHYMECRIME_BUILD_DIR"] = bd
  # Preserve trained classifiers from the previous generated/current → runtime
  # so solo dict-build (e.g. deploy-new-data) does not lose them before rescore.
  cur = File.join(repo, "generated", "current")
  if File.symlink?(cur)
    old_rt = File.expand_path(File.readlink(cur), File.dirname(cur))
    %w[rarity_classifier.json relatedness_classifier.json prefix_classifier.json].each do |fn|
      src = File.join(old_rt, fn)
      FileUtils.cp(src, File.join(bd, "runtime", fn)) if File.exist?(src)
    end
  end
end
ENV["RHYMECRIME_BUILD_MODE"] = "final" if ENV["RHYMECRIME_BUILD_MODE"].to_s.empty?

Dir.chdir(dict_dir) do
  load File.join(dict_dir, "dict.rb")
  rebuild_rhymecrime_dictionaries
end

if ENV["RHYMECRIME_BUILD_MODE"] == "final" && ENV["RHYMECRIME_BUILD_DIR"] && !ENV["RHYMECRIME_BUILD_DIR"].empty?
  runtime = File.join(ENV["RHYMECRIME_BUILD_DIR"], "runtime")
  cur = File.join(repo, "generated", "current")
  FileUtils.ln_sf(runtime, cur)
end
