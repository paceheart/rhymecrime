#!/usr/bin/env ruby
# encoding: utf-8
#
# Rebuild RhymeCrime caches under <repo>/generated/.
# Loads lib/rhymecrime/dict/dict.rb (which requires constants, phonology, lexical, morphology, rime, frequency)
# with cwd = that directory (relative list files), then runs rebuild.
#
#   ./bin/dict-build
#
# Faster rebuilds while iterating (skips slow ConceptNet + Numberbatch exports; leaves prior generated files):
#   RHYMECRIME_DICT_SKIP_CONCEPTNET_NUMBERBATCH=1 ./bin/dict-build
#
# By default, exported word_dict omits rare headwords (frequency ≤ RARE_FREQ_MAX) and rdict is re-pruned.
# For rarity specs / weighted accuracy over rare rows, rebuild with:
#   INCLUDE_RARE_WORDS=1 ./bin/dict-build
#
# ConceptNet lemma cache (generated/*.en-kept-lemmas.txt.gz) is built by setup.sh after downloading
# assertions, or automatically at the start of dict-build if missing/stale. Optional manual refresh:
#   ./bin/preprocess-conceptnet-lemma-cache
#

repo = File.expand_path("..", __dir__)
dict_dir = File.join(repo, "lib", "rhymecrime", "dict")
$LOAD_PATH.unshift File.join(repo, "lib")

Dir.chdir(dict_dir) do
  load File.join(dict_dir, "dict.rb")
  rebuild_rhymecrime_dictionaries
end
