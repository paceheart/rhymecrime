#!/usr/bin/env ruby
# frozen_string_literal: true
# encoding: UTF-8
#
# Bridge: scan the +rhymecrime-feedback+ DynamoDB table populated by the
# deployed Lambda's +DynamoFeedbackStore+ and project each item into a CSV row
# whose schema matches +Rhymecrime::FeedbackStore::CsvFeedbackStore::HEADER+
# (timestamp, cue, related, verdict, ip, user_agent, session). The output file
# is then a drop-in input for +bin/augment-related-from-feedback+, which folds
# verdicts into +curated/related.csv+ — closing the loop documented in
# +lib/rhymecrime/feedback_store.rb+:
#
#   "+Scan+ the table to export all feedback into +curated/related.csv+ when
#    re-importing training data."
#
# Default output is +generated/feedback-from-ddb.csv+ (kept distinct from the
# local-dev sink at +generated/feedback.csv+ so a future +bin/run-local+
# session doesn't silently mix bytes with prod-derived rows). Run the augment
# step explicitly:
#
#   AWS_PROFILE=paceheart ./bin/export-feedback-from-dynamodb
#   FEEDBACK_CSV=generated/feedback-from-ddb.csv \
#     bundle exec ./bin/augment-related-from-feedback
#
# Schema reminder (from +DynamoFeedbackStore#record!+):
#   pk = "feedback#<cue>#<related>"   (cue, related are lowercased surface forms)
#   sk = ISO 8601 timestamp           (sub-second precision)
#   attrs = verdict, ip, user_agent, session
#
# +AWS_PROFILE+ is required (not optional) for the same reason it is in
# +bin/upload-to-dynamodb+: an unset profile lets the SDK default-chain pick a
# stale work-account credential, and exporting feedback from the wrong account
# silently produces an empty CSV (no error, no items, no clue why training
# data didn't move). The STS pre-flight prints the resolved account/arn so
# wrong-account scans abort visibly before the first +Scan+ call.
#
# Pagination: +Scan+ caps each response at 1 MB. We loop on +LastEvaluatedKey+
# until the table is exhausted; for the current scale (single-digit thousands
# of clicks max) this is well within one page, but the loop is correct under
# arbitrary growth and avoids a future "where did half my feedback go?"
# debugging session.

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "csv"
require "fileutils"
require "optparse"
require "aws-sdk-dynamodb"

require_relative "_aws_preflight"
require_relative "../lib/rhymecrime/feedback_store"
require_relative "../lib/rhymecrime/dict/utils_rhyme"

ROOT = File.expand_path("..", __dir__)
DEFAULT_OUT = File.join(ROOT, "generated", "feedback-from-ddb.csv")

out_path = DEFAULT_OUT
table_name = nil
region = ENV.fetch("AWS_REGION", "us-east-1")

original_argv = ARGV.dup

OptionParser.new do |o|
  o.on("--out=PATH", "Output CSV path (default: #{DEFAULT_OUT.sub(ROOT + '/', '')})") { |p| out_path = File.expand_path(p) }
  o.on("--table=NAME", "Override DDB feedback table name (default: derived from RHYMECRIME_FEEDBACK_TABLE_NAME / RHYMECRIME_TABLE_NAME)") { |n| table_name = n }
  o.on("--region=REGION", "AWS region (default: us-east-1 or AWS_REGION)") { |r| region = r }
end.parse!

profile, _identity = AwsPreflight.preflight!(
  script_name: "export-feedback-from-dynamodb",
  original_argv: original_argv,
  region: region,
)

table_name ||= Rhymecrime::FeedbackStore.feedback_table_name

puts "    region=#{region} table=#{table_name}"
puts "    out=#{out_path}"

client = Aws::DynamoDB::Client.new(region: region, profile: profile)

# +pk+ is +"feedback#<cue>#<related>"+. +String#split("#", 3)+ caps the split at
# 3 fields so a hypothetical +#+ inside a +related+ surface form (none today,
# but cheap to be defensive) doesn't get misattributed to +cue+. Returns
# +nil+ when the prefix is missing or either component is empty so callers
# can skip malformed items rather than emit garbage rows.
def split_pk(pk)
  return nil unless pk.is_a?(String) && pk.start_with?("feedback#")
  parts = pk.sub(/\Afeedback#/, "").split("#", 2)
  return nil if parts.size != 2
  cue, rel = parts
  return nil if cue.empty? || rel.empty?
  [cue, rel]
end

rows = []
last_key = nil
page = 0
loop do
  page += 1
  resp = client.scan(
    table_name: table_name,
    exclusive_start_key: last_key,
  )
  resp.items.each do |item|
    pk = item["pk"]
    next unless (parsed = split_pk(pk))
    cue, rel = parsed
    rows << {
      timestamp: item["sk"].to_s,
      cue: cue,
      related: rel,
      verdict: item["verdict"].to_s,
      ip: item["ip"].to_s,
      user_agent: item["user_agent"].to_s,
      session: item["session"].to_s,
    }
  end
  warn "  page #{page}: scanned=#{resp.scanned_count} cumulative=#{rows.size}"
  last_key = resp.last_evaluated_key
  break if last_key.nil? || last_key.empty?
end

# Stable sort by timestamp so re-runs produce the same byte sequence (helps
# with +diff+ / version-control review of generated CSVs) and the augment
# script's per-session timestamp-ordered replay is deterministic.
rows.sort_by! { |r| r[:timestamp] }

FileUtils.mkdir_p(File.dirname(out_path))
header = Rhymecrime::FeedbackStore::CsvFeedbackStore::HEADER
CSV.open(out_path, "w", encoding: "UTF-8") do |csv|
  csv << header
  rows.each { |r| csv << header.map { |k| r[k.to_sym] } }
end

puts "==> wrote #{rows.size} rows to #{out_path}"

# Quick "view" summary so this script also serves as the inspection tool —
# saves the user from also pulling the file into a spreadsheet just to see
# what's there. Mirrors the +pair_tally+ shape +augment-related-from-feedback+
# computes, *without* the per-session state machine: the goal here is "what
# clicks landed", not "what was the user's net intent" — the augment script
# owns the latter.
verdict_counts = Hash.new(0)
per_pair = Hash.new { |h, k| h[k] = { up: 0, down: 0, undo: 0 } }
rows.each do |r|
  v = r[:verdict].to_sym
  verdict_counts[v] += 1
  per_pair[[r[:cue], r[:related]]][v] += 1 if %i[up down undo].include?(v)
end

puts
puts "==> verdict totals: #{verdict_counts.map { |k, v| "#{k}=#{v}" }.join(" ")}"
unless per_pair.empty?
  puts "==> per-pair clicks (alphabetical):"
  per_pair.sort.each do |(cue, rel), c|
    puts "    #{cue} → #{rel}: up=#{c[:up]} down=#{c[:down]}#{c[:undo].positive? ? " undo=#{c[:undo]}" : ""}"
  end
end

puts
puts "Next step (optional): fold these into curated/related.csv:"
puts "  FEEDBACK_CSV=#{out_path.sub(ROOT + '/', '')} bundle exec ./bin/augment-related-from-feedback"
puts "  # add DRY_RUN=1 to preview the diff first"
