#!/usr/bin/env bash
# Run bin/dict-build under StackProf (sampling profiler: periodic stack snapshots in CPU mode).
#
#   ./bin/dict-build-profile                       # slim default
#
# Output: tmp/stackprof-dict-build-YYYYMMDD-HHMMSS.dump (or STACKPROF_OUT if set).
# Inspect:
#   stackprof tmp/stackprof-dict-build-*.dump --text --limit 40
#   stackprof tmp/stackprof-dict-build-*.dump --method Object#add_frequency_info
#
# Optional env (see stackprof/autorun):
#   STACKPROF_MODE=cpu|wall   (default: cpu — Ruby CPU time only; wall includes I/O wait)
#   STACKPROF_INTERVAL=1000   sample interval in microseconds (when set)
#   STACKPROF_IGNORE_GC=1     exclude GC from samples
#   STACKPROF_OUT=/path.dump  fixed output path
#
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

if ! ruby -e "require 'stackprof'" 2>/dev/null; then
  echo "dict-build-profile: install the stackprof gem:  gem install stackprof" >&2
  exit 1
fi

mkdir -p tmp
if [[ -z "${STACKPROF_OUT:-}" ]]; then
  export STACKPROF_OUT="tmp/stackprof-dict-build-$(date +%Y%m%d-%H%M%S).dump"
fi
export STACKPROF_MODE="${STACKPROF_MODE:-cpu}"

echo "StackProf sampling: mode=${STACKPROF_MODE} out=${STACKPROF_OUT}" >&2
exec ruby -rstackprof/autorun "${ROOT}/bin/dict-build" "$@"
