#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

echo "==> build (train classifiers + rebuild dict; skip with SKIP_BUILD=1)"
if [[ "${SKIP_BUILD:-0}" != "1" ]]; then
  ./bin/build
fi

if [[ "${SKIP_COMPUTE:-0}" == "1" ]]; then
  echo "==> skip compute (SKIP_COMPUTE=1)"
else
  echo "==> compute relatedness → related rows in generated/rhymecrime_local.sqlite3 (long run; smoke: ruby bin/compute-relatedness --max-cues=5 --dry-run)"
  bundle exec ruby bin/compute-relatedness
  echo "==> compute set_related → set_related rows in generated/rhymecrime_local.sqlite3"
  bundle exec ruby bin/compute-set-related
fi

echo "==> upload related + set_related + score to DynamoDB (word_dict + rime_dict ship as msgpack in the Lambda bundle, not DDB)"
bundle exec ruby bin/upload-to-dynamodb
bin/deploy-aws

echo "Done."
